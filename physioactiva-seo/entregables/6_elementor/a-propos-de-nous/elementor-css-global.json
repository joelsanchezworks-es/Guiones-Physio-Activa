"@id\": \"https://physioactiva.ch/#physiotherapy\"}, \"knowsLanguage\": [\"fr\", \"es\"]}, {\"@type\": \"FAQPage\", \"@id\": \"https://physioactiva.ch/a-propos-de-nous/#faq\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"Qui sont les physiothérapeutes de Physio Activa ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Francisco Díaz et Lucile Combes. Leurs titres et formations sont précisés ici : [À CONFIRMER : titres, formations, enregistrement professionnel].\"}}, {\"@type\": \"Question\", \"name\": \"Dans quelles langues pouvez-vous me recevoir ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"En français et en espagnol. Le portugais est [À CONFIRMER].\"}}, {\"@type\": \"Question\", \"name\": \"Faut-il une ordonnance ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Pour un remboursement par la LAMal, la LAA, l'AI ou l'AM, oui. Sans prescription médicale, les séances sont à votre charge.\"}}, {\"@type\": \"Question\", \"name\": \"Vous déplacez-vous à domicile ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Oui, à Ins et dans le Seeland et les Trois-Lacs, notamment à Morat, Neuchâtel, Bienne et dans le Vully. Contactez-nous pour vérifier votre adresse.\"}}]}]}</script>\n"}, "elements": []}], "isInner": false}], "isInner": false}], "page_settings": {"hide_title": "yes"}, "version": "0.4", "title": "Vos physiothérapeutes à Ins : l'équipe Physio Activa", "type": "page"}