}\n.pa-home .nav-cta>.btn{padding:11px 16px;font-size:13px}}\n</style>\n\n<script>\n(function(){\n  function safe(fn,n){try{fn()}catch(e){console.warn(n,e)}}\n  function initReveal(){\n    var els=document.querySelectorAll('.pa-home .reveal');\n    if(!('IntersectionObserver'in window)){els.forEach(function(e){e.classList.add('in')});return;}\n    var io=new IntersectionObserver(function(en){en.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target);}})},{threshold:0.05});\n    els.forEach(function(e){io.observe(e)});\n    setTimeout(function(){els.forEach(function(e){e.classList.add('in')})},6000);\n  }\n  function initFAQ(){\n    var list=document.querySelectorAll('.pa-home .faq');\n    list.forEach(function(d){\n      var ans=d.querySelector('.ans'),btn=d.querySelector('button');\n      if(d.classList.contains('open')&&ans)ans.style.maxHeight=ans.scrollHeight+'px';\n      btn.addEventListener('click',function(){\n        var open=d.classList.contains('open');\n        list.forEach(function(x){x.classList.remove('open');var a=x.querySelector('.ans');if(a)a.style.maxHeight=null;});\n        if(!open){d.classList.add('open');if(ans)ans.style.maxHeight=ans.scrollHeight+'px';}\n      });\n    });\n  }\n  function boot(){var r=document.querySelector('.pa-home');if(r)r.classList.add('is-js');safe(initReveal,'reveal');safe(initFAQ,'faq');}\n  if(document.readyState!=='loading'){boot();}else{document.addEventListener('DOMContentLoaded',boot);}\n})();\n</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@graph\": [{\"@type\": \"Physiotherapy\", \"@id\": \"https://physioactiva.ch/#physiotherapy\", \"name\": \"Physio Activa\", \"url\": \"https://physioactiva.ch/\", \"telephone\": \"+41766273838\", \"address\": {\"@type\": \"PostalAddress\", \"streetAddress\": \"Rämismatte 21\", \"postalCode\": \"3232\", \"addressLocality\": \"Ins\", \"addressRegion\": \"BE\", \"addressCountry\": \"CH\"}, \"geo\": {\"@type\": \"GeoCoordinates\", \"latitude\": 46.99819373769458, \"longitude\": 7.107723111532297}, \"openingHoursSpecification\": [{\"@type\": \"OpeningHoursSpecification\", \"dayOfWeek\": [\"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\"], \"opens\": \"08:30\", \"closes\": \"19:30\"}], \"areaServed\": [{\"@type\": \"City\", \"name\": \"Ins\"}, {\"@type\": \"City\", \"name\": \"Anet\"}, {\"@type\": \"City\", \"name\": \"Sugiez\"}, {\"@type\": \"City\", \"name\": \"Mont-Vully\"}, {\"@type\": \"City\", \"name\": \"Murten / Morat\"}, {\"@type\": \"City\", \"name\": \"Kerzers / Chiètres\"}, {\"@type\": \"City\", \"name\": \"Avenches\"}, {\"@type\": \"City\", \"name\": \"La Neuveville\"}, {\"@type\": \"City\", \"name\": \"Neuchâtel\"}, {\"@type\": \"City\", \"name\": \"Biel/Bienne\"}, {\"@type\": \"City\", \"name\": \"Lyss\"}], \"availableLanguage\": [\"fr\", \"es\"], \"sameAs\": [\"https://www.google.com/maps?cid=17004812906479027083\"]}, {\"@type\": \"WebPage\", \"@id\": \"https://physioactiva.ch/#webpage\", \"url\": \"https://physioactiva.ch/\", \"name\": \"Physio à Ins (Anet) et à domicile | Physio Activa\", \"description\": \"Physio à Ins (Anet) et physiothérapie à domicile dans le Seeland et les Trois-Lacs. Remboursé sur ordonnance (LAMal, LAA). Réservez en ligne.\", \"inLanguage\": \"fr-CH\", \"about\": {\"@id\": \"https://physioactiva.ch/#physiotherapy\"}}, {\"@type\": \"FAQPage\", \"@id\": \"https://physioactiva.ch/#faq\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"Faut-il une ordonnance pour aller chez le physio ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Pour que les séances soient remboursées par la LAMal, la LAA, l'AI ou l'AM, une prescription médicale est nécessaire. Elle est établie par votre médecin, qui indique le nombre de séances prescrites. Sans ordonnance, les séances sont à votre charge.\"}}, {\"@type\": \"Question\", \"name\": \"Quelle est la différence entre un kiné et un physiothérapeute ?\", \"acceptedAns