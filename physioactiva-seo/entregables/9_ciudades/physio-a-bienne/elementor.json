{"content": [{"id": "06b5170", "elType": "section", "settings": {"layout": "full_width", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "438fc7c", "elType": "column", "settings": {"_column_size": 100, "_inline_size": 100}, "elements": [{"id": "8859bce", "elType": "widget", "widgetType": "html", "settings": {"html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Inter:wght@400;500;600&display=swap');\n@import url('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css');\n/* === Header menu above hero (WordPress nav) === */\n.pa-nav{position:relative;z-index:1000}\n.pa-nav .pa-mega,.pa-nav .pa-dd{z-index:1001}\n.elementor-location-header,header:has(.pa-nav),section:has(.pa-nav),.e-con:has(.pa-nav){position:relative;z-index:1000}\n\n.pa-lp{--navy:#0E2C4F;--azure:#29A9E0;--azure-d:#1E8AC0;--tint:#EAF6FC;--soft:#F4F9FD;--ink:#12273F;--muted:#5C7186;--body:#41576c;--line:#E4EEF5;--wa:#25D366;--wa-d:#1FB457;\n  font-family:'Inter',system-ui,sans-serif !important;color:var(--ink);background:#fff;line-height:1.7;overflow-x:hidden}\n.pa-lp *,.pa-lp *::before,.pa-lp *::after{box-sizing:border-box}\n.pa-lp h1,.pa-lp h2,.pa-lp h3,.pa-lp p,.pa-lp ul,.pa-lp ol,.pa-lp figure,.pa-lp table{margin:0;padding:0}\n.pa-lp img{max-width:100%;height:auto;display:block}\n.pa-lp a{text-decoration:none !important}\n.pa-lp h1,.pa-lp h2,.pa-lp h3,.pa-lp .eyebrow,.pa-lp .btn{font-family:'Poppins',system-ui,sans-serif !important}\n.pa-lp .wrap{max-width:1180px;margin:0 auto;padding:0 24px}\n.pa-lp .sec{padding:72px 0}\n.pa-lp .sec.soft{background:var(--soft)}\n.pa-lp a:focus-visible,.pa-lp button:focus-visible{outline:3px solid var(--azure);outline-offset:3px}\n\n/* Eyebrow + section heads */\n.pa-lp .eyebrow{display:inline-flex;align-items:center;gap:10px;color:var(--azure);font-weight:600;font-size:13px;letter-spacing:.16em;text-transform:uppercase;margin-bottom:14px}\n.pa-lp .eyebrow::before{content:\"\";width:26px;height:2px;background:var(--azure);display:inline-block;pointer-events:none}\n.pa-lp .sec-head{max-width:760px;margin:0 auto 42px;text-align:center}\n.pa-lp .sec-head .eyebrow{justify-content:center}\n.pa-lp h2.title{font-size:36px !important;font-weight:700 !important;line-height:1.2 !important;color:var(--navy) !important;letter-spacing:-.5px;margin:0 0 12px !important}\n.pa-lp .sec-head p{color:var(--muted);font-size:17px}\n\n/* Buttons */\n.pa-lp .btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;background:var(--azure) !important;color:#fff !important;font-weight:600 !important;font-size:15px !important;line-height:1.2 !important;padding:15px 28px !important;border-radius:10px !important;border:none !important;cursor:pointer;transition:background .25s,transform .25s,box-shadow .25s}\n.pa-lp .btn:hover{background:var(--azure-d) !important;transform:translateY(-2px);box-shadow:0 12px 26px rgba(41,169,224,.32)}\n.pa-lp .btn i,.pa-lp .btn i::before{color:inherit !important}\n.pa-lp .btn.wa{background:var(--wa) !important}\n.pa-lp .btn.wa:hover{background:var(--wa-d) !important;box-shadow:0 12px 26px rgba(37,211,102,.34)}\n.pa-lp .btn.ghost{background:transparent !important;border:1.5px solid rgba(255,255,255,.4) !important}\n.pa-lp .btn.ghost:hover{background:rgba(255,255,255,.12) !important;box-shadow:none}\n.pa-lp .btn.outline{background:transparent !important;color:var(--azure-d) !important;border:1.5px solid var(--azure) !important;padding:12px 22px !important;font-size:14px !important}\n.pa-lp .btn.outline:hover{background:var(--azure) !important;color:#fff !important;box-shadow:none}\n\n/* Hero (image-forward, same as blog articles) */\n.pa-lp .art-hero-sec{position:relative;background-color:var(--navy);background-size:cover;background-position:center;padding:120px 24px;overflow:hidden}\n.pa-lp .art-hero-overlay{position:absolute;inset:0;background:rgba(0,0,0,.42);pointer-events:none}\n.pa-lp .art-hero{position:relative;text-align:center;max-width:880px;margin:0 auto;color:#fff}\n.pa-lp .art-hero .eyebrow{justify-content:center;color:#fff;letter-spacing:.18em;text-shadow:0 1px 12px rgba(0,0,0,.55)}\n.pa-lp .art-hero .eyebrow::before{width:30px}\n.pa-lp .art-hero h1{font-size:46px !important;font-weight:700 !important;line-height:1.12 !important;letter-spacing:-.6px;color:#fff !important;margin:10px 0 20px !important;text-shadow:0 2px 28px rgba(0,0,0,.6)}\n.pa-lp .hero-cta{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin:26px 0 0}\n.pa-lp .ameta{display:inline-flex;flex-wrap:wrap;justify-content:center;gap:8px 16px;color:#fff;font-size:14px;font-family:'Poppins',sans-serif;background:rgba(0,0,0,.32);border:1px solid rgba(255,255,255,.22);padding:10px 20px;border-radius:40px;-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}\n\n/* Breadcrumb */\n.pa-lp .crumbs{background:var(--soft);border-bottom:1px solid var(--line);font-size:13.5px}\n.pa-lp .crumbs ol{list-style:none !important;display:flex;flex-wrap:wrap;gap:6px;max-width:828px;margin:0 auto !important;padding:14px 24px !important}\n.pa-lp .crumbs li{color:var(--muted);margin:0 !important}\n.pa-lp .crumbs li+li::before{content:\"›\";margin-right:6px}\n.pa-lp .crumbs a{color:var(--azure-d) !important;font-weight:500}\n\n/* Article body */\n.pa-lp .article{max-width:780px;margin:0 auto}\n.pa-lp .article .lead-intro{font-size:18.5px;color:var(--ink);line-height:1.75;margin-bottom:28px}\n.pa-lp .article h2{font-size:28px !important;color:var(--navy) !important;font-weight:700 !important;line-height:1.25 !important;margin:52px 0 14px !important}\n.pa-lp .article p{color:var(--body);font-size:16.5px;line-height:1.8;margin-bottom:16px}\n.pa-lp .article a.inlink{color:var(--azure-d) !important;font-weight:600;border-bottom:1px solid rgba(41,169,224,.45)}\n.pa-lp .article a.inlink:hover{border-bottom-color:var(--azure-d)}\n.pa-lp .article figure{margin:28px 0 8px}\n.pa-lp .article figure img{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:16px}\n.pa-lp .article figcaption{font-size:13.5px;color:var(--muted);margin-top:10px}\n.pa-lp .inline-actions{display:flex;gap:12px;flex-wrap:wrap;margin:4px 0 6px}\n\n/* Quick facts table (extractable for Google & AI) */\n.pa-lp .fiche{border:1px solid var(--line);border-radius:16px;overflow:hidden;margin:4px 0 8px}\n.pa-lp .fiche table{width:100%;border-collapse:collapse !important;border:none !important;font-size:15.5px;margin:0 !important}\n.pa-lp .fiche caption{caption-side:top;text-align:left;background:var(--navy);color:#fff;font-family:'Poppins',sans-serif;font-weight:600;font-size:16px;padding:14px 20px}\n.pa-lp .fiche th,.pa-lp .fiche td{padding:13px 20px !important;border:none !important;border-top:1px solid var(--line) !important;text-align:left !important;vertical-align:top;line-height:1.6}\n.pa-lp .fiche th{width:32%;color:var(--navy) !important;font-family:'Poppins',sans-serif;font-weight:600 !important;font-size:14.5px;background:var(--soft) !important}\n.pa-lp .fiche td{color:var(--body) !important;background:#fff !important}\n\n/* Services link grid */\n.pa-lp .soins-list{list-style:none !important;display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:20px 0 8px !important;padding:0 !important}\n.pa-lp .soins-list li{margin:0 !important;list-style:none !important}\n.pa-lp .soins-list a{display:block;height:100%;background:#fff;border:1px solid var(--line);border-radius:12px;padding:14px 18px;transition:border-color .2s,background .2s}\n.pa-lp .soins-list a:hover{border-color:var(--azure);background:var(--tint)}\n.pa-lp .soins-list strong{display:block;font-family:'Poppins',sans-serif;font-weight:600;color:var(--navy);font-size:15.5px;line-height:1.35}\n.pa-lp .soins-list span{display:block;color:var(--muted);font-size:14px;line-height:1.5;margin-top:3px}\n\n/* Inline CTA */\n.pa-lp .cta-inline{background:var(--soft);border:1px solid var(--line);border-left:4px solid var(--azure);border-radius:12px;padding:22px 24px;margin:32px 0 8px}\n.pa-lp .cta-inline p{color:var(--ink);margin-bottom:14px}\n.pa-lp .cta-inline .btn{padding:12px 22px !important;font-size:14px !important}\n\n/* Why grid */\n.pa-lp .why-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px;max-width:980px;margin:0 auto}\n.pa-lp .wcard{background:#fff;border:1px solid var(--line);border-radius:18px;padding:30px 28px}\n.pa-lp .wcard .wic{width:52px;height:52px;border-radius:14px;background:var(--tint);color:var(--azure);display:flex;align-items:center;justify-content:center;font-size:21px;margin-bottom:16px}\n.pa-lp .wcard h3{font-size:20px !important;color:var(--navy) !important;font-weight:600 !important;line-height:1.3 !important;margin:0 0 8px !important}\n.pa-lp .wcard p{color:var(--muted);font-size:15px;line-height:1.7}\n\n/* FAQ */\n.pa-lp .faq-list{max-width:820px;margin:0 auto}\n.pa-lp .faq{border:1px solid var(--line);border-radius:14px;margin-bottom:14px;overflow:hidden;background:#fff;transition:border-color .25s,box-shadow .25s}\n.pa-lp .faq.open{border-color:var(--azure);box-shadow:0 14px 30px rgba(41,169,224,.10)}\n.pa-lp .faq h3{margin:0 !important;font-size:inherit !important;line-height:inherit !important}\n.pa-lp .faq button{width:100%;text-align:left;background:none !important;border:none !important;border-radius:0 !important;padding:20px 24px !important;font-family:'Poppins',sans-serif !important;font-weight:600 !important;font-size:17px !important;line-height:1.4 !important;color:var(--navy) !important;text-transform:none !important;letter-spacing:0 !important;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:16px}\n.pa-lp .faq .q-ic{width:30px;height:30px;border-radius:8px;background:var(--tint);color:var(--azure);display:flex;align-items:center;justify-content:center;flex:0 0 30px;transition:transform .3s,background .3s,color .3s}\n.pa-lp .faq.open .q-ic{background:var(--azure);color:#fff;transform:rotate(45deg)}\n.pa-lp.is-js .faq .ans{max-height:0;overflow:hidden;transition:max-height .35s ease}\n.pa-lp .faq .ans p{padding:0 24px 22px;color:var(--muted);font-size:15.5px;line-height:1.75}\n\n/* CTA band */\n.pa-lp .cta-band{background:var(--navy);color:#fff;text-align:center;position:relative;overflow:hidden;padding:88px 0}\n.pa-lp .cta-band::before{content:\"\";position:absolute;width:380px;height:380px;border-radius:50%;background:rgba(41,169,224,.14);top:-150px;right:-110px;pointer-events:none}\n.pa-lp .cta-band::after{content:\"\";position:absolute;width:240px;height:240px;border-radius:50%;border:2px dashed rgba(255,255,255,.08);bottom:-90px;left:-70px;pointer-events:none}\n.pa-lp .cta-band .wrap{position:relative}\n.pa-lp .cta-band h2{font-size:36px !important;font-weight:700 !important;line-height:1.2 !important;color:#fff !important;letter-spacing:-.5px;margin:0 0 14px !important}\n.pa-lp .cta-band .s1{font-size:18.5px;color:#DCE9F4;max-width:720px;margin:0 auto 30px}\n.pa-lp .cta-actions{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;align-items:center}\n\n/* Map */\n.pa-lp .map iframe{width:100%;height:480px;border:0;display:block}\n\n/* Reveal */\n.pa-lp .reveal{transition:opacity .7s ease,transform .7s ease}\n.pa-lp.is-js .reveal{opacity:0;transform:translateY(22px)}\n.pa-lp.is-js .reveal.in{opacity:1;transform:none}\n\n/* WhatsApp FAB (standard) */\n.pa-wafab{position:fixed;right:22px;bottom:104px;z-index:1200;width:58px;height:58px;border-radius:50%;background:#25D366;color:#fff !important;display:flex;align-items:center;justify-content:center;font-size:30px;text-decoration:none !important;animation:paWaPulse 2.2s infinite;transition:background .2s}\n.pa-wafab:hover{background:#1FB457}\n.pa-wafab i,.pa-wafab i::before{color:#fff !important}\n@keyframes paWaPulse{0%{box-shadow:0 0 0 0 rgba(37,211,102,.55)}70%{box-shadow:0 0 0 16px rgba(37,211,102,0)}100%{box-shadow:0 0 0 0 rgba(37,211,102,0)}}\n\n/* === Añadidos SEO (mismo estilo) === */\n.pa-lp .article h3{font-size:20px !important;color:var(--navy) !important;font-weight:600 !important;line-height:1.3 !important;margin:28px 0 8px !important}\n.pa-lp .article ul.plain{margin:0 0 16px 20px !important;color:var(--body);font-size:16.5px;line-height:1.8}\n.pa-lp .article ul.plain li{margin:4px 0}\n.pa-lp .article a.inlink,.pa-lp .faq .ans a,.pa-lp .wcard a{color:var(--azure-d) !important;font-weight:600}\n.pa-lp .photo-credit{position:absolute;right:12px;bottom:8px;font-size:11px;color:rgba(255,255,255,.75);font-family:'Inter',sans-serif}\n.pa-lp .photo-credit a{color:rgba(255,255,255,.85) !important;text-decoration:underline !important}\n\n@media(max-width:980px){\n  .pa-lp .art-hero h1{font-size:38px !important}\n  .pa-lp h2.title,.pa-lp .cta-band h2{font-size:30px !important}\n}\n@media(max-width:620px){\n  .pa-lp .sec{padding:54px 0}\n  .pa-lp .art-hero-sec{padding:84px 18px 76px}\n  .pa-lp .art-hero h1{font-size:30px !important}\n  .pa-lp .article h2{font-size:23px !important;margin-top:42px !important}\n  .pa-lp .why-grid,.pa-lp .soins-list{grid-template-columns:1fr}\n  .pa-lp .hero-cta .btn,.pa-lp .cta-actions .btn{width:100%}\n  .pa-lp .fiche th,.pa-lp .fiche td{display:block;width:100%}\n  .pa-lp .fiche th{padding-bottom:2px !important}\n  .pa-lp .fiche td{border-top:none !important;padding-top:2px !important;background:var(--soft) !important}\n  .pa-lp .map iframe{height:380px}\n  .pa-wafab{right:14px;bottom:92px;width:54px;height:54px;font-size:28px}\n}\n@media(prefers-reduced-motion:reduce){\n  .pa-wafab{animation:none}\n  .pa-lp .reveal,.pa-lp.is-js .reveal{transition:none;opacity:1;transform:none}\n}\n\n</style>\n\n<div class=\"pa-lp\">\n\n<!-- ===== HERO ===== -->\n<section class=\"art-hero-sec\" style=\"background-image:url('https://physioactiva.ch/wp-content/uploads/2025/06/Centerbild_IMG_9184-scaled-1.jpg')\">\n  <div class=\"art-hero-overlay\" aria-hidden=\"true\"></div>\n  <div class=\"art-hero\">\n    <span class=\"eyebrow\">Physiothérapie · Bienne (Biel)</span>\n    <h1>Physio à Bienne : au cabinet d&#x27;Ins ou à domicile</h1>\n    <div class=\"ameta\">Par l'équipe Physio Activa · Physiothérapie à Bienne</div>\n    <div class=\"hero-cta\"><a class=\"btn\" href=\"https://www.onedoc.ch/fr/cabinet-de-physiotherapie/anet/ebdut/physioactiva\" target=\"_blank\" rel=\"noopener\"><i class=\"fa-solid fa-calendar-check\" aria-hidden=\"true\"></i> <span>Rendez-vous online</span></a><a class=\"btn wa\" href=\"https://wa.me/41766273838?text=Bonjour%2C%20je%20souhaite%20prendre%20rendez-vous%20chez%20Physio%20Activa%20%28physio%20%C3%A0%20Bienne%29.\" target=\"_blank\" rel=\"noopener\"><i class=\"fa-brands fa-whatsapp\" aria-hidden=\"true\"></i> <span>WhatsApp</span></a></div>\n  </div>\n  \n</section>\n\n<!-- ===== BREADCRUMB ===== -->\n<nav class=\"crumbs\" aria-label=\"Fil d'Ariane\">\n  <ol><li><a href=\"/\">Accueil</a></li><li aria-current=\"page\">Physiothérapie à Bienne</li></ol>\n</nav>\n\n<!-- ===== ARTICLE ===== -->\n<section class=\"sec\">\n <div class=\"wrap\">\n  <article class=\"article\">\n   <p class=\"lead-intro\">Vous cherchez un physiothérapeute à Bienne – Biel pour les germanophones – qui prenne le temps de vous écouter ? Physio Activa vous accueille à Ins, à environ 18 km en ligne droite du centre-ville, et nos physiothérapeutes viennent aussi chez vous. Rendez-vous dans la semaine dans la plupart des cas, en ligne, par téléphone ou sur WhatsApp.</p>\n\n   <div class=\"fiche\">\n    <table>\n     <caption>Physio Activa pour les patients de Bienne, en bref</caption>\n     <tbody>\n      <tr><th scope=\"row\">Cabinet</th><td>Rämismatte 21, 3232 Ins (1er étage du bâtiment Lidl, InsGym), parking à disposition</td></tr>\n      <tr><th scope=\"row\">Depuis Bienne</th><td>Environ 18,0 km à vol d&#x27;oiseau jusqu&#x27;au cabinet d&#x27;Ins</td></tr>\n      <tr><th scope=\"row\">À domicile</th><td>Bienne et environs (Nidau, Brügg, Port, Ipsach, Evilard)</td></tr>\n      <tr><th scope=\"row\">Délai</th><td>Rendez-vous dans la semaine dans la plupart des cas</td></tr>\n      <tr><th scope=\"row\">Horaires</th><td>Du lundi au vendredi, jusqu&#x27;à 20h</td></tr>\n      <tr><th scope=\"row\">Langues</th><td>Français, allemand, anglais, espagnol et portugais</td></tr>\n      <tr><th scope=\"row\">Assurances</th><td>Cabinet reconnu par toutes les compagnies d&#x27;assurance maladie en Suisse</td></tr>\n      <tr><th scope=\"row\">Réservation</th><td>En ligne (OneDoc), par WhatsApp ou au 076 627 38 38</td></tr>\n     </tbody>\n    </table>\n   </div>\n\n      <h2>Un physiothérapeute près de Bienne</h2>\n   <p>Le cabinet est installé à Ins, Rämismatte 21, au 1er étage du bâtiment Lidl, à l'intérieur d'InsGym. On s'y gare facilement, et l'on passe en quelques pas du traitement manuel aux exercices guidés.</p>\n   <p>Dans une ville bilingue, la langue compte : notre équipe parle français, allemand, anglais, espagnol et portugais. Vous expliquez ce que vous ressentez dans la langue où vous êtes le plus à l'aise, et vos documents médicaux en allemand restent parfaitement utilisables. Les séances sont possibles jusqu'à 20h, du lundi au vendredi, pour venir après le travail.</p>\n   <p>Les motifs qui nous amènent des patients pour une physiothérapie à Bienne sont variés : nuque tendue par les heures d'écran, épaule qui accroche, talon douloureux au réveil, cheville fragile après une entorse, mal de dos qui revient à chaque déménagement.</p>\n   <div class=\"inline-actions\"><a class=\"btn outline\" href=\"https://www.google.com/maps/dir/?api=1&amp;origin=Bienne%2C%20Suisse&amp;destination=Physio%20Activa%2C%20R%C3%A4mismatte%2021%2C%203232%20Ins\" target=\"_blank\" rel=\"noopener\"><i class=\"fa-solid fa-route\" aria-hidden=\"true\"></i> <span>Itinéraire depuis Bienne</span></a></div>\n   <figure>\n    <img src=\"https://physioactiva.ch/wp-content/uploads/2025/04/Physio-Activa-00031.jpg\" alt=\"Physiothérapeute de Physio Activa en séance, physio pour les patients de Bienne\" width=\"1200\" height=\"675\" loading=\"lazy\" decoding=\"async\">\n   </figure>\n   <h2>Physiothérapie à domicile à Bienne et environs</h2>\n   <p>Nos physiothérapeutes se déplacent à domicile à Bienne et dans les environs : Nidau, Brügg, Port, Ipsach et Evilard. Cette formule convient aux patients qui sortent de l'hôpital, à ceux qui peinent à monter dans un bus avec des béquilles, ou aux parents qui ne peuvent pas s'absenter longtemps.</p>\n   <p>Le drainage lymphatique et la plupart des exercices se font aussi bien dans votre salon qu'au cabinet. Tous les détails sur la page <a class=\"inlink\" href=\"/physiotherapeute-a-domicile/\">physiothérapie à domicile</a>.</p>\n   <h2>Nos soins de physiothérapie pour les patients de Bienne</h2>\n   <p>Vous avez accès à l'ensemble de nos soins, au cabinet d'Ins ou à domicile selon votre situation. Les plus demandés :</p>\n   <ul class=\"soins-list\"><li><a href=\"/drainage-lymphatique/\"><strong>Drainage lymphatique</strong><span>Œdèmes, jambes lourdes, suites opératoires.</span></a></li><li><a href=\"/massage-therapeutique/\"><strong>Massage thérapeutique</strong><span>Contractures et tensions musculaires.</span></a></li><li><a href=\"/physio-generale/\"><strong>Physiothérapie générale</strong><span>Douleurs, raideurs et gênes du quotidien.</span></a></li><li><a href=\"/physiotherapeute-a-domicile/\"><strong>Physiothérapie à domicile</strong><span>Les séances chez vous quand se déplacer est difficile.</span></a></li><li><a href=\"/mal-de-dos-lombaire/\"><strong>Mal de dos et lombalgie</strong><span>Lumbago, douleurs en position assise, rechutes.</span></a></li><li><a href=\"/sciatique-hernie-discale/\"><strong>Sciatique et hernie discale</strong><span>Douleur qui descend dans la jambe.</span></a></li><li><a href=\"/douleur-cervicale-au-cou/\"><strong>Douleur cervicale</strong><span>Nuque raide, torticolis, travail de bureau.</span></a></li><li><a href=\"/lesions-de-lepaule/\"><strong>Douleur de l&#x27;épaule</strong><span>Coiffe des rotateurs, tendinite, capsulite.</span></a></li><li><a href=\"/douleur-du-genou-lesions-de-la-cheville/\"><strong>Genou</strong><span>Ménisque, ligament croisé, arthrose, prothèse.</span></a></li><li><a href=\"/physiotherapie-post-operatoire/\"><strong>Physiothérapie post-opératoire</strong><span>Rééducation après une prothèse ou une chirurgie.</span></a></li></ul>\n   <div class=\"cta-inline\">\n    <p>Vous habitez Bienne et vous avez mal ? Nous vous proposons un rendez-vous dans la semaine dans la plupart des cas, au cabinet d’Ins ou chez vous.</p>\n    <a class=\"btn\" href=\"https://www.onedoc.ch/fr/cabinet-de-physiotherapie/anet/ebdut/physioactiva\" target=\"_blank\" rel=\"noopener\"><i class=\"fa-solid fa-calendar-check\" aria-hidden=\"true\"></i> <span>Rendez-vous online</span></a>\n   </div>\n   <h2>Quand consulter un physio, et quand voir d'abord un médecin ?</h2>\n   <p>Une douleur qui traîne plus d'une semaine, une raideur qui vous empêche de tourner la tête ou de lever le bras, une reprise sportive après une blessure : un physiothérapeute peut vous aider sans attendre.</p>\n   <p>Voyez en revanche un médecin en premier si la douleur suit un traumatisme important, si un bras ou une jambe s'affaiblit, si des fourmillements gagnent les deux côtés du corps, si une fièvre ou une perte de poids inexpliquée accompagne les symptômes, ou si un mollet devient rouge, chaud et gonflé. Douleur thoracique, malaise ou trouble soudain de la parole : appelez le 144.</p>\n   <h2>Quelle prise en charge selon votre situation ?</h2>\n   <h3>Nuque et épaule</h3>\n   <p>Tensions liées à l'écran, aux trajets ou au stress, tendinite ou épaule opérée : voir <a class=\"inlink\" href=\"/douleur-cervicale-au-cou/\">douleur cervicale</a> et <a class=\"inlink\" href=\"/lesions-de-lepaule/\">épaule</a>.</p>\n   <h3>Pied, cheville et dos</h3>\n   <p>Talon sensible, entorse qui traîne, reprise de la course au bord du lac, lombalgie aiguë ou installée : voir <a class=\"inlink\" href=\"/douleur-pied-cheville-fasciite-plantaire/\">pied et cheville, fasciite plantaire</a> et <a class=\"inlink\" href=\"/mal-de-dos-lombaire/\">mal de dos et lombalgie</a>.</p>\n   <h3>Drainage lymphatique</h3>\n   <p>Après une opération du genou ou de la hanche, en cas de lymphœdème ou de jambes qui gonflent en fin de journée, le drainage manuel relance la circulation de la lymphe par des gestes lents et légers. Plus d'informations sur le <a class=\"inlink\" href=\"/drainage-lymphatique/\">drainage lymphatique</a>.</p>\n   <h3>Massage thérapeutique</h3>\n   <p>Une contracture qui bloque la nuque ou le dos se relâche par des techniques ciblées, associées à des exercices. Voir le <a class=\"inlink\" href=\"/massage-therapeutique/\">massage thérapeutique</a>.</p>\n   <p>Autres motifs : <a class=\"inlink\" href=\"/pour-les-patients/\">toutes les pathologies</a>.</p>\n   <h2>Comment se déroule votre prise en charge ?</h2>\n   <h3>Prise de rendez-vous</h3>\n   <p>Choisissez un créneau en ligne et précisez si vous souhaitez une séance à domicile.</p>\n   <h3>Bilan</h3>\n   <p>Entretien, tests de mobilité et de force : nous cherchons ce qui entretient la douleur, pas seulement l'endroit où elle se manifeste.</p>\n   <h3>Séances au cabinet ou à domicile</h3>\n   <p>Techniques manuelles, exercices actifs et, selon l'indication, drainage ou massage.</p>\n   <h3>Autonomie et prévention</h3>\n   <p>Nous vous confions quelques exercices courts, faciles à caser entre le travail et les trajets, pour que le bénéfice dure.</p>\n   <figure>\n    <img src=\"https://physioactiva.ch/wp-content/uploads/2025/04/Physio-Activa-00036.jpg\" alt=\"Salle de traitement du cabinet Physio Activa à Ins, proche de Bienne\" width=\"1200\" height=\"675\" loading=\"lazy\" decoding=\"async\">\n   </figure>\n   <h2>Venir au cabinet d'Ins depuis Bienne</h2>\n   <p>Le cabinet se situe à environ 18 km en ligne droite du centre de Bienne, de l'autre côté du lac, dans le Seeland. Adresse, plan et indications pratiques : <a class=\"inlink\" href=\"/nous-trouver/\">Nous trouver</a>.</p>\n   <p>Après un séjour au Centre hospitalier Bienne, la rééducation peut se poursuivre chez nous ou chez vous, à partir des consignes de sortie.</p>\n   <h2>Assurances et horaires : physio à Bienne</h2>\n   <p>Notre cabinet est reconnu par toutes les compagnies d'assurance maladie en Suisse. Nous disposons de toutes les autorisations sanitaires nécessaires et accueillons les patients quel que soit leur canton de résidence. Ouvert du lundi au vendredi, jusqu'à 20h ; réservation en ligne, au 076 627 38 38 ou par WhatsApp.</p>\n  </article>\n </div>\n</section>\n\n<!-- ===== POURQUOI ===== -->\n<section class=\"sec soft\">\n <div class=\"wrap\">\n  <div class=\"sec-head reveal\">\n   <span class=\"eyebrow\">Pourquoi Physio Activa</span>\n   <h2 class=\"title\">Pourquoi les patients de Bienne choisissent Physio Activa</h2>\n   <p>Un cabinet de physiothérapie à Ins, des soins à domicile dans la région et une équipe qui vous reçoit en cinq langues.</p>\n  </div>\n  <div class=\"why-grid reveal\"><div class=\"wcard\"><div class=\"wic\" aria-hidden=\"true\"><i class=\"fa-solid fa-shield-heart\"></i></div><h3>Reconnu par toutes les assurances</h3><p>Notre cabinet est reconnu par toutes les compagnies d'assurance maladie en Suisse et dispose de toutes les autorisations sanitaires nécessaires.</p></div><div class=\"wcard\"><div class=\"wic\" aria-hidden=\"true\"><i class=\"fa-solid fa-house-medical\"></i></div><h3>Au cabinet ou à domicile</h3><p>Vous choisissez : le cabinet, dans le même canton de Berne, ou votre appartement si sortir reste compliqué.</p></div><div class=\"wcard\"><div class=\"wic\" aria-hidden=\"true\"><i class=\"fa-solid fa-clipboard-list\"></i></div><h3>Bilan et plan de traitement</h3><p>Avant tout traitement, nous évaluons la zone douloureuse, votre façon de bouger et vos contraintes de travail ou de sport.</p></div><div class=\"wcard\"><div class=\"wic\" aria-hidden=\"true\"><i class=\"fa-solid fa-calendar-check\"></i></div><h3>Rendez-vous en ligne, par téléphone ou WhatsApp</h3><p>L'agenda en ligne est ouvert jour et nuit ; une question avant de réserver ? Un message WhatsApp suffit.</p></div></div>\n </div>\n</section>\n\n<!-- ===== FAQ ===== -->\n<section class=\"sec\">\n <div class=\"wrap\">\n  <div class=\"sec-head\">\n   <span class=\"eyebrow\">Questions fréquentes</span>\n   <h2 class=\"title\">Questions fréquentes sur la physio à Bienne</h2>\n  </div>\n  <div class=\"faq-list\" id=\"paFaq\"><div class=\"faq open\"><h3><button type=\"button\" aria-expanded=\"true\" aria-controls=\"faq-a1\"><span class=\"faq-q\">Où trouver un physiothérapeute près de Bienne ?</span><span class=\"q-ic\" aria-hidden=\"true\"><i class=\"fa-solid fa-plus\"></i></span></button></h3><div class=\"ans\" id=\"faq-a1\"><p>À Ins, chez Physio Activa : Rämismatte 21, 1er étage du bâtiment Lidl, avec parking, à environ 18 km en ligne droite. Si vous ne pouvez pas vous déplacer, nos physiothérapeutes viennent à domicile à Bienne et dans les communes voisines.</p></div></div><div class=\"faq\"><h3><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-a2\"><span class=\"faq-q\">Quand dois-je consulter un physiothérapeute pour une douleur ?</span><span class=\"q-ic\" aria-hidden=\"true\"><i class=\"fa-solid fa-plus\"></i></span></button></h3><div class=\"ans\" id=\"faq-a2\"><p>Quand une nuque, une épaule ou une cheville reste douloureuse plus d'une semaine, limite votre mobilité ou perturbe votre sommeil. Plus on la traite tôt, plus c'est simple.</p></div></div><div class=\"faq\"><h3><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-a3\"><span class=\"faq-q\">Physio Activa travaille-t-il avec toutes les compagnies d&#x27;assurance ?</span><span class=\"q-ic\" aria-hidden=\"true\"><i class=\"fa-solid fa-plus\"></i></span></button></h3><div class=\"ans\" id=\"faq-a3\"><p>Oui. Notre cabinet est reconnu par toutes les compagnies d'assurance maladie en Suisse. Nous disposons de toutes les autorisations sanitaires nécessaires et accueillons les patients quel que soit leur canton de résidence.</p></div></div><div class=\"faq\"><h3><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-a4\"><span class=\"faq-q\">Combien de séances me faut-il ?</span><span class=\"q-ic\" aria-hidden=\"true\"><i class=\"fa-solid fa-plus\"></i></span></button></h3><div class=\"ans\" id=\"faq-a4\"><p>La durée du traitement varie selon votre situation, l'ancienneté des symptômes et votre rythme de travail. Lors de la première visite, nous établissons une estimation adaptée à votre cas.</p></div></div><div class=\"faq\"><h3><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-a5\"><span class=\"faq-q\">Dans quelle langue se déroule le traitement ?</span><span class=\"q-ic\" aria-hidden=\"true\"><i class=\"fa-solid fa-plus\"></i></span></button></h3><div class=\"ans\" id=\"faq-a5\"><p>En français, en allemand, en anglais, en espagnol ou en portugais : vous choisissez. Pour les patients d'une ville bilingue, c'est l'assurance de comprendre chaque exercice.</p></div></div><div class=\"faq\"><h3><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-a6\"><span class=\"faq-q\">Pouvez-vous venir à Nidau, Port ou Evilard ?</span><span class=\"q-ic\" aria-hidden=\"true\"><i class=\"fa-solid fa-plus\"></i></span></button></h3><div class=\"ans\" id=\"faq-a6\"><p>Oui. Nidau, Port, Evilard, Brügg et Ipsach font partie des environs où nous nous déplaçons. Indiquez votre adresse au moment de réserver.</p></div></div><div class=\"faq\"><h3><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-a7\"><span class=\"faq-q\">Je sors de l&#x27;hôpital : puis-je commencer tout de suite ?</span><span class=\"q-ic\" aria-hidden=\"true\"><i class=\"fa-solid fa-plus\"></i></span></button></h3><div class=\"ans\" id=\"faq-a7\"><p>Oui : apportez vos consignes de sortie. Le rendez-vous est en général possible dans la semaine, au cabinet ou chez vous.</p></div></div><div class=\"faq\"><h3><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-a8\"><span class=\"faq-q\">Comment savoir si j&#x27;ai besoin d&#x27;un drainage lymphatique ?</span><span class=\"q-ic\" aria-hidden=\"true\"><i class=\"fa-solid fa-plus\"></i></span></button></h3><div class=\"ans\" id=\"faq-a8\"><p>Un gonflement qui persiste après une opération, une jambe ou un bras qui reste lourd et tendu, ou un lymphœdème diagnostiqué sont les situations typiques. Parlez-en à votre médecin.</p></div></div><div class=\"faq\"><h3><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-a9\"><span class=\"faq-q\">Le drainage lymphatique est-il douloureux ?</span><span class=\"q-ic\" aria-hidden=\"true\"><i class=\"fa-solid fa-plus\"></i></span></button></h3><div class=\"ans\" id=\"faq-a9\"><p>Non. Les mouvements sont doux, lents et rythmés. Une zone opérée récemment peut être sensible : nous adaptons la pression.</p></div></div></div>\n </div>\n</section>\n\n<!-- ===== CTA BAND ===== -->\n<section class=\"cta-band\">\n <div class=\"wrap reveal\">\n  <h2>Besoin d&#x27;un physio à Bienne ou dans les environs ?</h2>\n  <p class=\"s1\">Réservez votre première séance en quelques clics sur la réservation en ligne , au 076 627 38 38 ou sur WhatsApp au +41 76 627 38 38.</p>\n  <div class=\"cta-actions\"><a class=\"btn\" href=\"https://www.onedoc.ch/fr/cabinet-de-physiotherapie/anet/ebdut/physioactiva\" target=\"_blank\" rel=\"noopener\"><i class=\"fa-solid fa-calendar-check\" aria-hidden=\"true\"></i> <span>Rendez-vous online</span></a><a class=\"btn wa\" href=\"https://wa.me/41766273838?text=Bonjour%2C%20je%20souhaite%20prendre%20rendez-vous%20chez%20Physio%20Activa%20%28physio%20%C3%A0%20Bienne%29.\" target=\"_blank\" rel=\"noopener\"><i class=\"fa-brands fa-whatsapp\" aria-hidden=\"true\"></i> <span>WhatsApp</span></a><a class=\"btn ghost\" href=\"tel:+41766273838\"><i class=\"fa-solid fa-phone\" aria-hidden=\"true\"></i> <span>Appelez-nous · 076 627 38 38</span></a></div>\n </div>\n</section>\n\n<!-- ===== MAP ===== -->\n<section class=\"map\">\n <iframe src=\"https://maps.google.com/maps?q=Physio%20Activa%2C%20R%C3%A4mismatte%2021%2C%203232%20Ins&amp;z=17&amp;hl=fr&amp;output=embed\" title=\"Physio Activa — Rämismatte 21, 3232 Ins\" loading=\"lazy\" allowfullscreen referrerpolicy=\"no-referrer-when-downgrade\"></iframe>\n</section>\n\n<a class=\"pa-wafab\" href=\"https://wa.me/41766273838?text=Bonjour%2C%20je%20souhaite%20prendre%20rendez-vous%20chez%20Physio%20Activa%20%28physio%20%C3%A0%20Bienne%29.\" target=\"_blank\" rel=\"noopener\" aria-label=\"Contacter Physio Activa sur WhatsApp\"><i class=\"fa-brands fa-whatsapp\" aria-hidden=\"true\"></i></a>\n\n</div>\n\n<script>\n(function(){\n  function safe(fn,n){try{fn()}catch(e){console.warn(n,e)}}\n  function initReveal(){\n    var els=document.querySelectorAll('.pa-lp .reveal');\n    if(!('IntersectionObserver' in window)){els.forEach(function(e){e.classList.add('in')});return;}\n    var io=new IntersectionObserver(function(en){en.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target);}})},{threshold:0.05});\n    els.forEach(function(e){io.observe(e)});\n    setTimeout(function(){els.forEach(function(e){e.classList.add('in')})},6000);\n  }\n  function initFAQ(){\n    var l=document.getElementById('paFaq'); if(!l)return;\n    var items=l.querySelectorAll('.faq');\n    items.forEach(function(d){\n      var btn=d.querySelector('button'),ans=d.querySelector('.ans');\n      if(d.classList.contains('open'))ans.style.maxHeight=ans.scrollHeight+'px';\n      btn.addEventListener('click',function(){\n        var open=d.classList.contains('open');\n        items.forEach(function(x){x.classList.remove('open');x.querySelector('.ans').style.maxHeight=null;x.querySelector('button').setAttribute('aria-expanded','false');});\n        if(!open