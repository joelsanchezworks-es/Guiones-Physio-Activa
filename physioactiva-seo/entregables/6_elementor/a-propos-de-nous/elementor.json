px)}\n.pa-home.is-js .reveal.in{opacity:1;transform:none}\n\n\n  \n  @media(max-width:980px){.pa-home .hero .wrap, .pa-home .why .wrap, .pa-home .map .wrap{grid-template-columns:1fr}\n.pa-home .hero h1{font-size:40px}\n.pa-home .hero-img{order:-1}\n.pa-home .hero-img>img{height:340px}\n.pa-home h2.title{font-size:31px}\n.pa-home .trust-grid, .pa-home .serv-grid, .pa-home .avis-grid{grid-template-columns:1fr 1fr}\n.pa-home .stats-grid{grid-template-columns:1fr 1fr;gap:36px}\n.pa-home .stat:nth-child(3){border-left:none}\n.pa-home .gal-grid{grid-template-columns:1fr 1fr;grid-auto-rows:170px}\n.pa-home .fgrid{grid-template-columns:1fr 1fr}\n.pa-home nav.menu{display:none}\n.pa-home .burger{display:block}\n.pa-home .has-sub .submenu{position:static;opacity:1;visibility:visible;transform:none;box-shadow:none;border:none;padding:2px 0 2px 14px;min-width:auto;display:block}\n.pa-home .submenu-lg{grid-template-columns:1fr}}\n\n  @media(max-width:620px){.pa-home section{padding:64px 0}\n.pa-home .trust-grid, .pa-home .serv-grid, .pa-home .avis-grid, .pa-home .team-grid, .pa-home .fgrid{grid-template-columns:1fr}\n.pa-home .why-grid{grid-template-columns:1fr}\n.pa-home .topbar .wrap{justify-content:center}\n.pa-home .topbar .socials{display:none}\n.pa-home .why-img .exp{right:10px}\n.pa-home .nav-cta{gap:10px}\n.pa-home .lang-btn{padding:9px 11px}\n.pa-home .lang-btn #langCur{display:none}\n.pa-home .nav-cta>.btn{padding:11px 16px;font-size:13px}}\n\n/* ===== Pages condition ===== */\n.pa-home .assur-sec{background:var(--soft)}\n.pa-home .assur-sec .lead{margin:0 auto 8px}\n.pa-home .steps{max-width:760px;margin:24px auto 26px;text-align:left;display:grid;gap:14px;padding:0}\n.pa-home .steps li{list-style:none;display:flex;gap:14px;align-items:flex-start;background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px 20px}\n.pa-home .steps .num{flex:0 0 32px;width:32px;height:32px;border-radius:50%;background:var(--azure);color:#fff;font-family:'Poppins';font-weight:600;display:flex;align-items:center;justify-content:center;font-size:15px}\n.pa-home .steps p{color:var(--ink);font-size:14.5px;margin:0;line-height:1.55}\n\n</style>\n\n<script>\n(function(){\n  function safe(fn,n){try{fn()}catch(e){console.warn(n,e)}}\n  function initReveal(){\n    var els=document.querySelectorAll('.pa-home .reveal');\n    if(!('IntersectionObserver'in window)){els.forEach(function(e){e.classList.add('in')});return;}\n    var io=new IntersectionObserver(function(en){en.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target);}})},{threshold:0.05});\n    els.forEach(function(e){io.observe(e)});\n    setTimeout(function(){els.forEach(function(e){e.classList.add('in')})},6000);\n  }\n  function initFAQ(){\n    var list=document.querySelectorAll('.pa-home .faq');\n    list.forEach(function(d){\n      var ans=d.querySelector('.ans'),btn=d.querySelector('button');\n      if(d.classList.contains('open')&&ans)ans.style.maxHeight=ans.scrollHeight+'px';\n      btn.addEventListener('click',function(){\n        var open=d.classList.contains('open');\n        list.forEach(function(x){x.classList.remove('open');var a=x.querySelector('.ans');if(a)a.style.maxHeight=null;});\n        if(!open){d.classList.add('open');if(ans)ans.style.maxHeight=ans.scrollHeight+'px';}\n      });\n    });\n  }\n  function boot(){var r=document.querySelector('.pa-home');if(r)r.classList.add('is-js');safe(initReveal,'reveal');safe(initFAQ,'faq');}\n  if(document.readyState!=='loading'){boot();}else{document.addEventListener('DOMContentLoaded',boot);}\n})();\n</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@graph\": [{\"@type\": \"Physiotherapy\", \"@id\": \"https://physioactiva.ch/#physiotherapy\", \"name\": \"Physio Activa\", \"url\": \"https://physioactiva.ch/\", \"telephone\": \"+41766273838\", \"address\": {\"@type\": \"PostalAddress\", \"streetAddress\": \"Rämismatte 21\", \"postalCode\": \"3232\", 