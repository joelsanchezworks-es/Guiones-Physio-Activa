lor:var(--ink);position:relative}\n.pa-home nav.menu>a:hover{color:var(--azure)}\n.pa-home .has-sub{position:relative}\n.pa-home .has-sub>a{display:inline-flex;align-items:center;gap:6px;cursor:pointer}\n.pa-home .submenu{position:absolute;top:140%;left:-18px;background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:0 18px 50px rgba(14,44,79,.14);padding:10px;min-width:266px;opacity:0;visibility:hidden;transform:translateY(8px);transition:.22s}\n.pa-home .has-sub:hover .submenu{opacity:1;visibility:visible;transform:translateY(0)}\n.pa-home .has-sub>a, .pa-home .sub-toggle{font-size:14px;font-weight:500;color:var(--ink)}\n.pa-home .submenu-lg{min-width:540px;display:grid;grid-template-columns:1fr 1fr;gap:0}\n.pa-home .submenu a{display:block;padding:9px 14px;border-radius:8px;font-size:14px;color:var(--ink)}\n.pa-home .submenu a:hover{background:var(--tint);color:var(--azure)}\n.pa-home .nav-cta{display:flex;align-items:center;gap:16px}\n.pa-home .burger{display:none;font-size:24px;color:var(--navy);background:none;border:none;cursor:pointer}\n.pa-home .hero{position:relative;background:var(--navy);color:#fff;overflow:hidden}\n.pa-home .hero::before{content:\"\";position:absolute;width:520px;height:520px;border-radius:50%;background:rgba(41,169,224,.16);top:-160px;right:-120px}\n.pa-home .hero::after{content:\"\";position:absolute;width:300px;height:300px;border-radius:50%;border:2px dashed rgba(255,255,255,.10);bottom:-90px;left:-60px}\n.pa-home .hero .wrap{position:relative;display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center;padding-top:88px;padding-bottom:88px}\n.pa-home .hero h1{font-size:52px;line-height:1.1;font-weight:700;letter-spacing:-1px;margin-bottom:22px}\n.pa-home .hero h1 span{color:var(--azure)}\n.pa-home .hero p.sub{color:#c3d6e6;font-size:17.5px;max-width:540px;margin-bottom:32px}\n.pa-home .hero-cta{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:30px}\n.pa-home .hero-pills{display:flex;gap:22px;flex-wra