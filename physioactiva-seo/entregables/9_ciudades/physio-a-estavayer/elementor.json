{"content": [{"id": "4e7b9dd", "elType": "section", "settings": {"layout": "full_width", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "dbf8da2", "elType": "column", "settings": {"_column_size": 100, "_inline_size": 100}, "elements": [{"id": "78e5513", "elType": "widget", "widgetType": "html", "settings": {"html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Inter:wght@400;500;600&display=swap');\n@import url('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css');\n/* === Header menu above hero (WordPress nav) === */\n.pa-nav{position:relative;z-index:1000}\n.pa-nav .pa-mega,.pa-nav .pa-dd{z-index:1001}\n.elementor-location-header,header:has(.pa-nav),section:has(.pa-nav),.e-con:has(.pa-nav){position:relative;z-index:1000}\n\n.pa-lp{--navy:#0E2C4F;--azure:#29A9E0;--azure-d:#1E8AC0;--tint:#EAF6FC;--soft:#F4F9FD;--ink:#12273F;--muted:#5C7186;--body:#41576c;--line:#E4EEF5;--wa:#25D366;--wa-d:#1FB457;\n  font-family:'Inter',system-ui,sans-serif !important;color:var(--ink);background:#fff;line-height:1.7;overflow-x:hidden}\n.pa-lp *,.pa-lp *::before,.pa-lp *::after{box-sizing:border-box}\n.pa-lp h1,.pa-lp h2,.pa-lp h3,.pa-lp p,.pa-lp ul,.pa-lp ol,.pa-lp figure,.pa-lp table{margin:0;padding:0}\n.pa-lp img{max-width:100%;height:auto;display:block}\n.pa-lp a{text-decoration:none !important}\n.pa-lp h1,.pa-lp h2,.pa-lp h3,.pa-lp .eyebrow,.pa-lp .btn{font-family:'Poppins',system-ui,sans-serif !important}\n.pa-lp .wrap{max-width:1180px;margin:0 auto;padding:0 24px}\n.pa-lp .sec{padding:72px 0}\n.pa-lp .sec.soft{background:var(--soft)}\n.pa-lp a:focus-visible,.pa-lp button:focus-visible{outline:3px solid var(--azure);outline-offset:3px}\n\n/* Eyebrow + section heads */\n.pa-lp .eyebrow{display:inline-flex;align-items:center;gap:10px;color:var(--azure);font-weight:600;font-size:13px;letter-spacing:.16em;text-transform:uppercase;margin-bottom:14px}\n.pa-lp .eyebrow::before{content:\"\";width:26px;height:2px;background:var(--azure);display:inline-block;pointer-events:none}\n.pa-lp .sec-head{max-width:760px;margin:0 auto 42px;text-align:center}\n.pa-lp .sec-head .eyebrow{justify-content:center}\n.pa-lp h2.title{font-size:36px !important;font-weight:700 !important;line-height:1.2 !important;color:var(--navy) !important;letter-spacing:-.5px;margin:0 0 12px !important}\n.pa-lp .sec-head p{color:var(--muted);font-size:17px}\n\n/* Buttons */\n.pa-lp .btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;background:var(--azure) !important;color:#fff !important;font-weight:600 !important;font-size:15px !important;line-height:1.2 !important;padding:15px 28px !important;border-radius:10px !important;border:none !important;cursor:pointer;transition:background .25s,transform .25s,box-shadow .25s}\n.pa-lp .btn:hover{background:var(--azure-d) !important;transform:translateY(-2px);box-shadow:0 12px 26px rgba(41,169,224,.32)}\n.pa-lp .btn i,.pa-lp .btn i::before{color:inherit !important}\n.pa-lp .btn.wa{background:var(--wa) !important}\n.pa-lp .btn.wa:hover{background:var(--wa-d) !important;box-shadow:0 12px 26px rgba(37,211,102,.34)}\n.pa-lp .btn.ghost{background:transparent !important;border:1.5px solid rgba(255,255,255,.4) !important}\n.pa-lp .btn.ghost:hover{background:rgba(255,255,255,.12) !important;box-shadow:none}\n.pa-lp .btn.outline{background:transparent !important;color:var(--azure-d) !important;border:1.5px solid var(--azure) !important;padding:12px 22px !important;font-size:14px !important}\n.pa-lp .btn.outline:hover{background:var(--azure) !important;color:#fff !important;box-shadow:none}\n\n/* Hero (image-forward, same as blog articles) */\n.pa-lp .art-hero-sec{position:relative;background-color:var(--navy);background-size:cover;background-position:center;padding:120px 24px;overflow:hidden}\n.pa-lp .art-hero-overlay{position:absolute;inset:0;background:rgba(0,0,0,.42);pointer-events:none}\n.pa-lp .art-hero{position:relative;text-align:center;max-width:880px;margin:0 auto;color:#fff}\n.pa-lp .art-hero .eyebrow{justify-content:center;color:#fff;letter-spacing:.18em;text-shadow:0 1px 12px rgba(0,0,0,.55)}\n.pa-lp .art-hero .eyebrow::before{width:30px}\n.pa-lp .art-hero h1{font-size:46px !important;font-weight:700 !important;line-height:1.12 !important;letter-spacing:-.6px;color:#fff !important;margin:10px 0 20px !important;text-shadow:0 2px 28px rgba(0,0,0,.6)}\n.pa-lp .hero-cta{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin:26px 0 0}\n.pa-lp .ameta{display:inline-flex;flex-wrap:wrap;justify-content:center;gap:8px 16px;color:#fff;font-size:14px;font-family:'Poppins',sans-serif;background:rgba(0,0,0,.32);border:1px solid rgba(255,255,255,.22);padding:10px 20px;border-radius:40px;-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}\n\n/* Breadcrumb */\n.pa-lp .crumbs{background:var(--soft);border-bottom:1px solid var(--line);font-size:13.5px}\n.pa-lp .crumbs ol{list-style:none !important;display:flex;flex-wrap:wrap;gap:6px;max-width:828px;margin:0 auto !important;padding:14px 24px !important}\n.pa-lp .crumbs li{color:var(--muted);margin:0 !important}\n.pa-lp .crumbs li+li::before{content:\"›\";margin-right:6px}\n.pa-lp .crumbs a{color:var(--azure-d) !important;font-weight:500}\n\n/* Article body */\n.pa-lp .article{max-width:780px;margin:0 auto}\n.pa-lp .article .lead-intro{font-size:18.5px;color:var(--ink);line-height:1.75;margin-bottom:28px}\n.pa-lp .article h2{font-size:28px !important;color:var(--navy) !important;font-weight:700 !important;line-height:1.25 !important;margin:52px 0 14px !important}\n.pa-lp .article p{color:var(--body);font-size:16.5px;line-height:1.8;margin-bottom:16px}\n.pa-lp .article a.inlink{color:var(--azure-d) !important;font-weight:600;border-bottom:1px solid rgba(41,169,224,.45)}\n.pa-lp .article a.inlink:hover{border-bottom-color:var(--azure-d)}\n.pa-lp .article figure{margin:28px 0 8px}\n.pa-lp .article figure img{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:16px}\n.pa-lp .article figcaption{font-size:13.5px;color:var(--muted);margin-top:10px}\n.pa-lp .inline-actions{display:flex;gap:12px;flex-wrap:wrap;margin:4px 0 6px}\n\n/* Quick facts table (extractable for Google & AI) */\n.pa-lp .fiche{border:1px solid var(--line);border-radius:16px;overflow:hidden;margin:4px 0 8px}\n.pa-lp .fiche table{width:100%;border-collapse:collapse !important;border:none !important;font-size:15.5px;margin:0 !important}\n.pa-lp .fiche caption{caption-side:top;text-align:left;background:var(--navy);color:#fff;font-family:'Poppins',sans-serif;font-weight:600;font-size:16px;padding:14px 20px}\n.pa-lp .fiche th,.pa-lp .fiche td{padding:13px 20px !important;border:none !important;border-top:1px solid var(--line) !important;text-align:left !important;vertical-align:top;line-height:1.6}\n.pa-lp .fiche th{width:32%;color:var(--navy) !important;font-family:'Poppins',sans-serif;font-weight:600 !important;font-size:14.5px;background:var(--soft) !important}\n.pa-lp .fiche td{color:var(--body) !important;background:#fff !important}\n\n/* Services link grid */\n.pa-lp .soins-list{list-style:none !important;display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:20px 0 8px !important;padding:0 !important}\n.pa-lp .soins-list li{margin:0 !important;list-style:none !important}\n.pa-lp .soins-list a{display:block;height:100%;background:#fff;border:1px solid var(--line);border-radius:12px;padding:14px 18px;transition:border-color .2s,background .2s}\n.pa-lp .soins-list a:hover{border-color:var(--azure);background:var(--tint)}\n.pa-lp .soins-list strong{display:block;font-family:'Poppins',sans-serif;font-weight:600;color:var(--navy);font-size:15.5px;line-height:1.35}\n.pa-lp .soins-list span{display:block;color:var(--muted);font-size:14px;line-height:1.5;margin-top:3px}\n\n/* Inline CTA */\n.pa-lp .cta-inline{background:var(--soft);border:1px solid var(--line);border-left:4px solid var(--azure);border-radius:12px;padding:22px 24px;margin:32px 0 8px}\n.pa-lp .cta-inline p{color:var(--ink);margin-bottom:14px}\n.pa-lp .cta-inline .btn{padding:12px 22px !important;font-size:14px !important}\n\n/* Why grid */\n.pa-lp .why-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px;max-width:980px;margin:0 auto}\n.pa-lp .wcard{background:#fff;border:1px solid var(--line);border-radius:18px;padding:30px 28px}\n.pa-lp .wcard .wic{width:52px;height:52px;border-radius:14px;background:var(--tint);color:var(--azure);display:flex;align-items:center;justify-content:center;font-size:21px;margin-bottom:16px}\n.pa-lp .wcard h3{font-size:20px !important;color:var(--navy) !important;font-weight:600 !important;line-height:1.3 !important;margin:0 0 8px !important}\n.pa-lp .wcard p{color:var(--muted);font-size:15px;line-height:1.7}\n\n/* FAQ */\n.pa-lp .faq-list{max-width:820px;margin:0 auto}\n.pa-lp .faq{border:1px solid var(--line);border-radius:14px;margin-bottom:14px;overflow:hidden;background:#fff;transition:border-color .25s,box-shadow .25s}\n.pa-lp .faq.open{border-color:var(--azure);box-shadow:0 14px 30px rgba(41,169,224,.10)}\n.pa-lp .faq h3{margin:0 !important;font-size:inherit !important;line-height:inherit !important}\n.pa-lp .faq button{width:100%;text-align:left;background:none !important;border:none !important;border-radius:0 !important;padding:20px 24px !important;font-family:'Poppins',sans-serif !important;font-weight:600 !important;font-size:17px !important;line-height:1.4 !important;color:var(--navy) !important;text-transform:none !important;letter-spacing:0 !important;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:16px}\n.pa-lp .faq .q-ic{width:30px;height:30px;border-radius:8px;background:var(--tint);color:var(--azure);display:flex;align-items:center;justify-content:center;flex:0 0 30px;transition:transform .3s,background .3s,color .3s}\n.pa-lp .faq.open .q-ic{background:var(--azure);color:#fff;transform:rotate(45deg)}\n.pa-lp.is-js .faq .ans{max-height:0;overflow:hidden;transition:max-height .35s ease}\n.pa-lp .faq .ans p{padding:0 24px 22px;color:var(--muted);font-size:15.5px;line-height:1.75}\n\n/* CTA band */\n.pa-lp .cta-band{background:var(--navy);color:#fff;text-align:center;position:relative;overflow:hidden;padding:88px 0}\n.pa-lp .cta-band::before{content:\"\";position:absolute;width:380px;height:380px;border-radius:50%;background:rgba(41,169,224,.14);top:-150px;right:-110px;pointer-events:none}\n.pa-lp .cta-band::after{content:\"\";position:absolute;width:240px;height:240px;border-radius:50%;border:2px dashed rgba(255,255,255,.08);bottom:-90px;left:-70px;pointer-events:none}\n.pa-lp .cta-band .wrap{position:relative}\n.pa-lp .cta-band h2{font-size:36px !important;font-weight:700 !important;line-height:1.2 !important;color:#fff !important;letter-spacing:-.5px;margin:0 0 14px !important}\n.pa-lp .cta-band .s1{font-size:18.5px;color:#DCE9F4;max-width:720px;margin:0 auto 30px}\n.pa-lp .cta-actions{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;align-items:center}\n\n/* Map */\n.pa-lp .map iframe{width:100%;height:480px;border:0;display:block}\n\n/* Reveal */\n.pa-lp .reveal{transition:opacity .7s ease,transform .7s ease}\n.pa-lp.is-js .reveal{opacity:0;transform:translateY(22px)}\n.pa-lp.is-js .reveal.in{opacity:1;transform:none}\n\n/* WhatsApp FAB (standard) */\n.pa-wafab{position:fixed;right:22px;bottom:104px;z-index:1200;width:58px;height:58px;border-radius:50%;background:#25D366;color:#fff !important;display:flex;align-items:center;justify-content:center;font-size:30px;text-decoration:none !important;animation:paWaPulse 2.2s infinite;transition:background .2s}\n.pa-wafab:hover{background:#1FB457}\n.pa-wafab i,.pa-wafab i::before{color:#fff !important}\n@keyframes paWaPulse{0%{box-shadow:0 0 0 0 rgba(37,211,102,.55)}70%{box-shadow:0 0 0 16px rgba(37,211,102,0)}100%{box-shadow:0 0 0 0 rgba(37,211,102,0)}}\n\n/* === Añadidos SEO (mismo estilo) === */\n.pa-lp .article h3{font-size:20px !important;color:var(--navy) !important;font-weight:600 !important;line-height:1.3 !important;margin:28px 0 8px !important}\n.pa-lp .article ul.plain{margin:0 0 16px 20px !important;color:var(--body);font-size:16.5px;line-height:1.8}\n.pa-lp .article ul.plain li{margin:4px 0}\n.pa-lp .article a.inlink,.pa-lp .faq .ans a,.pa-lp .wcard a{color:var(--azure-d) !important;font-weight:600}\n.pa-lp .photo-credit{position:absolute;right:12px;bottom:8px;font-size:11px;color:rgba(255,255,255,.75);font-family:'Inter',sans-serif}\n.pa-lp .photo-credit a{color:rgba(255,255,255,.85) !important;text-decoration:underline !important}\n\n@media(max-width:980px){\n  .pa-lp .art-hero h1{font-size:38px !important}\n  .pa-lp h2.title,.pa-lp .cta-band h2{font-size:30px !important}\n}\n@media(max-width:620px){\n  .pa-lp .sec{padding:54px 0}\n  .pa-lp .art-hero-sec{padding:84px 18px 76px}\n  .pa-lp .art-hero h1{font-size:30px !important}\n  .pa-lp .article h2{font-size:23px !important;margin-top:42px !important}\n  .pa-lp .why-grid,.pa-lp .soins-list{grid-template-columns:1fr}\n  .pa-lp .hero-cta .btn,.pa-lp .cta-actions .btn{width:100%}\n  .pa-lp .fiche th,.pa-lp .fiche td{display:block;width:100%}\n  .pa-lp .fiche th{padding-bottom:2px !important}\n  .pa-lp .fiche td{border-top:none !important;padding-top:2px !important;background:var(--soft) !important}\n  .pa-lp .map iframe{height:380px}\n  .pa-wafab{right:14px;bottom:92px;width:54px;height:54px;font-size:28px}\n}\n@media(prefers-reduced-motion:reduce){\n  .pa-wafab{animation:none}\n  .pa-lp .reveal,.pa-lp.is-js .reveal{transition:none;opacity:1;transform:none}\n}\n\n</style>\n\n<div class=\"pa-lp\">\n\n<!-- ===== HERO ===== -->\n<section class=\"art-hero-sec\" style=\"background-image:url('https://physioactiva.ch/wp-content/uploads/2025/06/Centerbild_IMG_9184-scaled-1.jpg')\">\n  <div class=\"art-hero-overlay\" aria-hidden=\"true\"></div>\n  <div class=\"art-hero\">\n    <span class=\"eyebrow\">Physiothérapie · Estavayer-le-Lac</span>\n    <h1>Physio à Estavayer-le-Lac : au cabinet d&#x27;Ins ou à domicile</h1>\n    <div class=\"ameta\">Par l'équipe Physio Activa · Physiothérapie à Estavayer</div>\n    <div class=\"hero-cta\"><a class=\"btn\" href=\"https://www.onedoc.ch/fr/cabinet-de-physiotherapie/anet/ebdut/physioactiva\" target=\"_blank\" rel=\"noopener\"><i class=\"fa-solid fa-calendar-check\" aria-hidden=\"true\"></i> <span>Rendez-vous online</span></a><a class=\"btn wa\" href=\"https://wa.me/41766273838?text=Bonjour%2C%20je%20souhaite%20prendre%20rendez-vous%20chez%20Physio%20Activa%20%28physio%20%C3%A0%20Estavayer%29.\" target=\"_blank\" rel=\"noopener\"><i class=\"fa-brands fa-whatsapp\" aria-hidden=\"true\"></i> <span>WhatsApp</span></a></div>\n  </div>\n  \n</section>\n\n<!-- ===== BREADCRUMB ===== -->\n<nav class=\"crumbs\" aria-label=\"Fil d'Ariane\">\n  <ol><li><a href=\"/\">Accueil</a></li><li aria-current=\"page\">Physiothérapie à Estavayer</li></ol>\n</nav>\n\n<!-- ===== ARTICLE ===== -->\n<section class=\"sec\">\n <div class=\"wrap\">\n  <article class=\"article\">\n   <p class=\"lead-intro\">Vous cherchez un physio à Estavayer pour une épaule, un pied, une sciatique ou un gonflement après une opération ? Physio Activa vous reçoit dans son cabinet d'Ins, à environ 26,4 km en ligne droite de la Broye, et peut, selon votre adresse, venir chez vous. Le rendez-vous se prend en ligne, par téléphone ou sur WhatsApp.</p>\n\n   <div class=\"fiche\">\n    <table>\n     <caption>Physio Activa pour les patients de Estavayer, en bref</caption>\n     <tbody>\n      <tr><th scope=\"row\">Cabinet</th><td>Rämismatte 21, 3232 Ins (1er étage du bâtiment Lidl, InsGym), parking à disposition</td></tr>\n      <tr><th scope=\"row\">Depuis Estavayer</th><td>Environ 26,4 km à vol d&#x27;oiseau jusqu&#x27;au cabinet d&#x27;Ins</td></tr>\n      <tr><th scope=\"row\">À domicile</th><td>Selon votre adresse (Font, Cheyres-Châbles, Sévaz, Les Montets) : contactez-nous pour le vérifier</td></tr>\n      <tr><th scope=\"row\">Délai</th><td>Rendez-vous dans la semaine dans la plupart des cas</td></tr>\n      <tr><th scope=\"row\">Horaires</th><td>Du lundi au vendredi, jusqu&#x27;à 20h</td></tr>\n      <tr><th scope=\"row\">Langues</th><td>Français, allemand, anglais, espagnol et portugais</td></tr>\n      <tr><th scope=\"row\">Assurances</th><td>Cabinet reconnu par toutes les compagnies d&#x27;assurance maladie en Suisse</td></tr>\n      <tr><th scope=\"row\">Réservation</th><td>En ligne (OneDoc), par WhatsApp ou au 076 627 38 38</td></tr>\n     </tbody>\n    </table>\n   </div>\n\n      <h2>Un physiothérapeute près d'Estavayer-le-Lac</h2>\n   <p>Soyons clairs : nous n'avons pas de cabinet sur place. Si vous cherchez un physiothérapeute à Estavayer même, notre adresse est à Ins, Rämismatte 21, au 1er étage du bâtiment Lidl, dans les locaux d'InsGym, avec parking à disposition. Depuis la Broye, comptez environ 26,4 km en ligne droite : un trajet à intégrer dans votre agenda.</p>\n   <p>Pourquoi faire la route ? Parce que le même thérapeute vous suit du bilan à la dernière séance, que la salle d'InsGym permet de travailler la force et l'équilibre sur des appareils, et que le cabinet reste ouvert jusqu'à 20h en semaine. Beaucoup de patients regroupent leurs rendez-vous avec une course ou un déplacement dans le Seeland.</p>\n   <p>Les personnes qui cherchent une physiothérapie à Estavayer viennent surtout chez nous pour une épaule douloureuse, un talon qui pique, une sciatique, un genou arthrosique, une rééducation après une opération ou un drainage lymphatique.</p>\n   <div class=\"inline-actions\"><a class=\"btn outline\" href=\"https://www.google.com/maps/dir/?api=1&amp;origin=Estavayer%2C%20Suisse&amp;destination=Physio%20Activa%2C%20R%C3%A4mismatte%2021%2C%203232%20Ins\" target=\"_blank\" rel=\"noopener\"><i class=\"fa-solid fa-route\" aria-hidden=\"true\"></i> <span>Itinéraire depuis Estavayer</span></a></div>\n   <figure>\n    <img src=\"https://physioactiva.ch/wp-content/uploads/2025/04/Physio-Activa-00031.jpg\" alt=\"Physiothérapeute de Physio Activa en séance, physio pour les patients de Estavayer\" width=\"1200\" height=\"675\" loading=\"lazy\" decoding=\"async\">\n   </figure>\n   <h2>Physiothérapie à domicile à Estavayer-le-Lac et environs</h2>\n   <p>Certaines personnes ne peuvent pas faire le trajet : juste après une prothèse, au retour d'une hospitalisation ou quand la marche devient trop difficile. Pour elles, une séance à domicile à Estavayer peut remplacer la venue au cabinet. Selon votre adresse, nous pouvons aussi venir à domicile : contactez-nous pour le vérifier. La question se pose de la même façon pour Font, Cheyres-Châbles, Sévaz ou Les Montets : un appel suffit pour savoir ce qui est possible chez vous. Le principe est décrit sur la page <a class=\"inlink\" href=\"/physiotherapeute-a-domicile/\">physiothérapie à domicile</a>.</p>\n   <h2>Nos soins de physiothérapie pour les patients de Estavayer</h2>\n   <p>Vous avez accès à l'ensemble de nos soins, au cabinet d'Ins ou à domicile selon votre situation. Les plus demandés :</p>\n   <ul class=\"soins-list\"><li><a href=\"/drainage-lymphatique/\"><strong>Drainage lymphatique</strong><span>Œdèmes, jambes lourdes, suites opératoires.</span></a></li><li><a href=\"/physio-generale/\"><strong>Physiothérapie générale</strong><span>Douleurs, raideurs et gênes du quotidien.</span></a></li><li><a href=\"/physiotherapeute-a-domicile/\"><strong>Physiothérapie à domicile</strong><span>Les séances chez vous quand se déplacer est difficile.</span></a></li><li><a href=\"/mal-de-dos-lombaire/\"><strong>Mal de dos et lombalgie</strong><span>Lumbago, douleurs en position assise, rechutes.</span></a></li><li><a href=\"/sciatique-hernie-discale/\"><strong>Sciatique et hernie discale</strong><span>Douleur qui descend dans la jambe.</span></a></li><li><a href=\"/douleur-cervicale-au-cou/\"><strong>Douleur cervicale</strong><span>Nuque raide, torticolis, travail de bureau.</span></a></li><li><a href=\"/lesions-de-lepaule/\"><strong>Douleur de l&#x27;épaule</strong><span>Coiffe des rotateurs, tendinite, capsulite.</span></a></li><li><a href=\"/douleur-du-genou-lesions-de-la-cheville/\"><strong>Genou</strong><span>Ménisque, ligament croisé, arthrose, prothèse.</span></a></li><li><a href=\"/physiotherapie-post-operatoire/\"><strong>Physiothérapie post-opératoire</strong><span>Rééducation après une prothèse ou une chirurgie.</span></a></li><li><a href=\"/physio-du-sport/\"><strong>Physiothérapie du sport</strong><span>Blessures, surcharge et retour à l&#x27;entraînement.</span></a></li></ul>\n   <div class=\"cta-inline\">\n    <p>Vous habitez Estavayer et vous avez mal ? Nous vous proposons un rendez-vous dans la semaine dans la plupart des cas, au cabinet d’Ins ou à domicile selon votre adresse.</p>\n    <a class=\"btn\" href=\"https://www.onedoc.ch/fr/cabinet-de-physiotherapie/anet/ebdut/physioactiva\" target=\"_blank\" rel=\"noopener\"><i class=\"fa-solid fa-calendar-check\" aria-hidden=\"true\"></i> <span>Rendez-vous online</span></a>\n   </div>\n   <h2>Quand consulter un physio, et quand voir d'abord un médecin ?</h2>\n   <p>Une épaule qui fait mal dès qu'on lève le bras, un talon douloureux au réveil, des fourmillements qui descendent dans la jambe, un genou qui limite la marche, une jambe qui reste enflée après une chirurgie : ce sont des raisons typiques de consulter.</p>\n   <p>Voyez d'abord un médecin, ou appelez le 144 si la situation est grave, en présence :\n- d'un gonflement soudain d'une jambe, chaud et douloureux ;\n- d'une douleur intense après une chute ou un choc ;\n- de fourmillements avec perte de force ou troubles urinaires ;\n- de fièvre, de frissons ou d'une plaie opératoire qui rougit.</p>\n   <h2>Quelle prise en charge selon votre situation ?</h2>\n   <h3>Après une opération ou une hospitalisation</h3>\n   <p>Opéré ou hospitalisé à l'HIB, sur le site d'Estavayer-le-Lac ? Nous reprenons la rééducation sur la base des consignes de sortie, au cabinet ou chez vous si votre adresse le permet.</p>\n   <h3>Drainage lymphatique</h3>\n   <p>Vous cherchez un drainage lymphatique à Estavayer ? Après une opération du genou ou de la hanche, une entorse sévère ou en cas de lymphœdème, un gonflement peut persister. Le drainage manuel aide la lymphe à circuler et s'accompagne de conseils et d'exercices simples. En savoir plus : <a class=\"inlink\" href=\"/drainage-lymphatique/\">drainage lymphatique</a>.</p>\n   <h3>Épaule, pied, sciatique, genou</h3>\n   <ul class=\"plain\"><li><a class=\"inlink\" href=\"/lesions-de-lepaule/\">Épaule</a> : douleur en levant le bras, conflit sous-acromial, suites d'une luxation.</li><li><a class=\"inlink\" href=\"/douleur-pied-cheville-fasciite-plantaire/\">Pied et cheville, fasciite plantaire</a> : talon douloureux, entorses répétées, reprise de la course.</li><li><a class=\"inlink\" href=\"/sciatique-hernie-discale/\">Sciatique et hernie discale</a> : douleur qui irradie dans la jambe, gestion des phases aiguës.</li><li><a class=\"inlink\" href=\"/douleur-du-genou-lesions-de-la-cheville/\">Genou</a> : arthrose, ligament croisé, rééducation après arthroscopie.</li></ul>\n   <p>Liste complète : <a class=\"inlink\" href=\"/pour-les-patients/\">toutes les pathologies</a>.</p>\n   <h3>Renforcement sur appareils</h3>\n   <p>Quand la douleur se calme, la <a class=\"inlink\" href=\"/medical-training-therapy-mtt/\">Medical Training Therapy (MTT)</a> permet de reconstruire force et endurance sur machines, avec un programme suivi.</p>\n   <h2>Comment se déroule votre prise en charge ?</h2>\n   <h3>Prise de rendez-vous</h3>\n   <p>Réservez en ligne ou par téléphone en précisant s'il s'agit de rééducation ou de drainage lymphatique. Nous essayons de regrouper vos rendez-vous pour limiter les trajets.</p>\n   <h3>Bilan</h3>\n   <p>Nous analysons vos limitations, mesurons mobilité et force et, en cas d'œdème, observons le gonflement. Les objectifs sont fixés ensemble.</p>\n   <h3>Séances au cabinet ou à domicile</h3>\n   <p>Comme le trajet compte, chaque séance est construite pour être utile : traitement, exercices et conseils, sans temps perdu.</p>\n   <h3>Autonomie et prévention</h3>\n   <p>Entre deux visites, vous travaillez seul grâce à un programme écrit. Le but : espacer les séances dès que possible et éviter les rechutes.</p>\n   <figure>\n    <img src=\"https://physioactiva.ch/wp-content/uploads/2025/04/Physio-Activa-00036.jpg\" alt=\"Salle de traitement du cabinet Physio Activa à Ins, proche de Estavayer\" width=\"1200\" height=\"675\" loading=\"lazy\" decoding=\"async\">\n   </figure>\n   <h2>Venir au cabinet d'Ins depuis Estavayer-le-Lac</h2>\n   <p>Ins se trouve à environ 26,4 km en ligne droite d'Estavayer, commune du district de la Broye, dans le canton de Fribourg. Le cabinet est au 1er étage du bâtiment Lidl, Rämismatte 21, avec parking sur place. Plan et accès : <a class=\"inlink\" href=\"/nous-trouver/\">Nous trouver</a>.</p>\n   <p>Estavayer est francophone, et toute la prise en charge se fait en français ; nous parlons aussi allemand, anglais, espagnol et portugais.</p>\n   <h2>Assurances et horaires : physio à Estavayer-le-Lac</h2>\n   <p>Que vous veniez pour une rééducation ou un drainage lymphatique, notre cabinet est reconnu par toutes les compagnies d'assurance maladie en Suisse et accueille les patients quel que soit leur canton de résidence. Il est ouvert du lundi au vendredi, jusqu'à 20h, ce qui laisse le temps de faire la route après le travail. Réservez en ligne, au 076 627 38 38 ou sur WhatsApp.</p>\n  </article>\n </div>\n</section>\n\n<!-- ===== POURQUOI ===== -->\n<section class=\"sec soft\">\n <div class=\"wrap\">\n  <div class=\"sec-head reveal\">\n   <span class=\"eyebrow\">Pourquoi Physio Activa</span>\n   <h2 class=\"title\">Pourquoi les patients de Estavayer choisissent Physio Activa</h2>\n   <p>Un cabinet de physiothérapie à Ins, des soins à domicile dans la région et une équipe qui vous reçoit en cinq langues.</p>\n  </div>\n  <div class=\"why-grid reveal\"><div class=\"wcard\"><div class=\"wic\" aria-hidden=\"true\"><i class=\"fa-solid fa-shield-heart\"></i></div><h3>Reconnu par toutes les assurances</h3><p>Notre cabinet est reconnu par toutes les assurances maladie en Suisse : habiter dans la Broye fribourgeoise ne change rien pour vous.</p></div><div class=\"wcard\"><div class=\"wic\" aria-hidden=\"true\"><i class=\"fa-solid fa-house-medical\"></i></div><h3>Au cabinet ou à domicile</h3><p>Le cabinet d'Ins est notre seule adresse. Selon votre adresse, nous pouvons aussi venir à domicile : contactez-nous pour le vérifier.</p></div><div class=\"wcard\"><div class=\"wic\" aria-hidden=\"true\"><i class=\"fa-solid fa-clipboard-list\"></i></div><h3>Bilan et plan de traitement</h3><p>La première séance sert à comprendre votre problème, à mesurer mobilité et force, puis à fixer avec vous un plan de séances.</p></div><div class=\"wcard\"><div class=\"wic\" aria-hidden=\"true\"><i class=\"fa-solid fa-calendar-check\"></i></div><h3>Rendez-vous en ligne, par téléphone ou WhatsApp</h3><p><a class=\"inlink\" href=\"/reservation-en-ligne/\">Réservation en ligne</a>, 076 627 38 38 ou WhatsApp au +41 76 627 38 38 : un rendez-vous dans la semaine dans la plupart des cas.</p></div></div>\n </div>\n</section>\n\n<!-- ===== FAQ ===== -->\n<section class=\"sec\">\n <div class=\"wrap\">\n  <div class=\"sec-head\">\n   <span class=\"eyebrow\">Questions fréquentes</span>\n   <h2 class=\"title\">Questions fréquentes sur la physio à Estavayer-le-Lac</h2>\n  </div>\n  <div class=\"faq-list\" id=\"paFaq\"><div class=\"faq open\"><h3><button type=\"button\" aria-expanded=\"true\" aria-controls=\"faq-a1\"><span class=\"faq-q\">Où trouver un physiothérapeute près d&#x27;Estavayer-le-Lac ?</span><span class=\"q-ic\" aria-hidden=\"true\"><i class=\"fa-solid fa-plus\"></i></span></button></h3><div class=\"ans\" id=\"faq-a1\"><p>Notre cabinet est à Ins, Rämismatte 21, au 1er étage du bâtiment Lidl, avec parking, à environ 26,4 km en ligne droite d'Estavayer. Selon votre adresse, nous pouvons aussi venir à domicile : contactez-nous pour le vérifier.</p></div></div><div class=\"faq\"><h3><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-a2\"><span class=\"faq-q\">Quand dois-je consulter un physiothérapeute pour une douleur ?</span><span class=\"q-ic\" aria-hidden=\"true\"><i class=\"fa-solid fa-plus\"></i></span></button></h3><div class=\"ans\" id=\"faq-a2\"><p>Quand la douleur dure depuis plus d'une semaine, réduit votre mobilité ou trouble votre sommeil, ou quand un gonflement persiste après une opération. Plus on la traite tôt, plus c'est simple. Un mollet soudain chaud et enflé se montre d'abord au médecin.</p></div></div><div class=\"faq\"><h3><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-a3\"><span class=\"faq-q\">Physio Activa travaille-t-il avec toutes les compagnies d&#x27;assurance ?</span><span class=\"q-ic\" aria-hidden=\"true\"><i class=\"fa-solid fa-plus\"></i></span></button></h3><div class=\"ans\" id=\"faq-a3\"><p>Oui. Notre cabinet est reconnu par toutes les compagnies d'assurance maladie en Suisse. Nous disposons de toutes les autorisations sanitaires nécessaires et accueillons les patients quel que soit leur canton de résidence.</p></div></div><div class=\"faq\"><h3><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-a4\"><span class=\"faq-q\">Combien de séances me faut-il ?</span><span class=\"q-ic\" aria-hidden=\"true\"><i class=\"fa-solid fa-plus\"></i></span></button></h3><div class=\"ans\" id=\"faq-a4\"><p>La durée du traitement varie selon votre situation, et le trajet depuis la Broye est pris en compte dans le rythme proposé. Lors de la première visite, nous établissons une estimation adaptée à votre cas.</p></div></div><div class=\"faq\"><h3><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-a5\"><span class=\"faq-q\">Venez-vous à Font, à Sévaz ou à Cheyres-Châbles ?</span><span class=\"q-ic\" aria-hidden=\"true\"><i class=\"fa-solid fa-plus\"></i></span></button></h3><div class=\"ans\" id=\"faq-a5\"><p>Ces villages, comme Les Montets, sont proches d'Estavayer. Selon votre adresse, nous pouvons aussi venir à domicile : contactez-nous pour le vérifier.</p></div></div><div class=\"faq\"><h3><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-a6\"><span class=\"faq-q\">Comment choisir son physiothérapeute ?</span><span class=\"q-ic\" aria-hidden=\"true\"><i class=\"fa-solid fa-plus\"></i></span></button></h3><div class=\"ans\" id=\"faq-a6\"><p>Que vous choisissiez un physiothérapeute à Estavayer ou à Ins, vérifiez qu'il est reconnu par les assurances, qu'il traite votre problème et que vous comprenez ses explications. La distance et les horaires comptent aussi.</p></div></div><div class=\"faq\"><h3><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-a7\"><span class=\"faq-q\">Comment savoir si j&#x27;ai besoin d&#x27;un drainage lymphatique ?</span><span class=\"q-ic\" aria-hidden=\"true\"><i class=\"fa-solid fa-plus\"></i></span></button></h3><div class=\"ans\" id=\"faq-a7\"><p>Un gonflement qui persiste après une opération, une jambe lourde qui garde la marque du doigt ou un lymphœdème diagnostiqué sont des signes à montrer au médecin, qui oriente vers le drainage si besoin.</p></div></div><div class=\"faq\"><h3><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-a8\"><span class=\"faq-q\">Puis-je commencer après une hospitalisation à l&#x27;HIB ?</span><span class=\"q-ic\" aria-hidden=\"true\"><i class=\"fa-solid fa-plus\"></i></span></button></h3><div class=\"ans\" id=\"faq-a8\"><p>Oui. Avec les consignes remises à la sortie, nous organisons la suite de votre rééducation, avec un rendez-vous dans la semaine dans la plupart des cas.</p></div></div><div class=\"faq\"><h3><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-a9\"><span class=\"faq-q\">Dans quelles langues se passent les séances ?</span><span class=\"q-ic\" aria-hidden=\"true\"><i class=\"fa-solid fa-plus\"></i></span></button></h3><div class=\"ans\" id=\"faq-a9\"><p>En français, la langue d'Estavayer, mais aussi en allemand, en anglais, en espagnol ou en portugais si vous préférez.</p></div></div></div>\n </div>\n</section>\n\n<!-- ===== CTA BAND ===== -->\n<section class=\"cta-band\">\n <div class=\"wrap reveal\">\n  <h2>Besoin d&#x27;un physio à Estavayer-le-Lac ou dans les environs ?</h2>\n  <p class=\"s1\">Choisissez un créneau en réservation en ligne , ou contactez-nous au 076 627 38 38 ou sur WhatsApp au +41 76 627 38 38 : nous vous dirons si le cabinet ou le domicile vous convient le mieux.</p>\n  <div class=\"cta-actions\"><a class=\"btn\" href=\"https://www.onedoc.ch/fr/cabinet-de-physiotherapie/anet/ebdut/physioactiva\" target=\"_blank\" rel=\"noopener\"><i class=\"fa-solid fa-calendar-check\" aria-hidden=\"true\"></i> <span>Rendez-vous online</span></a><a class=\"btn wa\" href=\"https://wa.me/41766273838?text=Bonjour%2C%20je%20souhaite%20prendre%20rendez-vous%20chez%20Physio%20Activa%20%28physio%20%C3%A0%20Estavayer%29.\" target=\"_blank\" rel=\"noopener\"><i class=\"fa-brands fa-whatsapp\" aria-hidden=\"true\"></i> <span>WhatsApp</span></a><a class=\"btn ghost\" href=\"tel:+41766273838\"><i class=\"fa-solid fa-phone\" aria-hidden=\"true\"></i> <span>Appelez-nous · 076 627 38 38</span></a></div>\n </div>\n</section>\n\n<!-- ===== MAP ===== -->\n<section class=\"map\">\n <iframe src=\"https://maps.google.com/maps?q=Physio%20Activa%2C%20R%C3%A4mismatte%2021%2C%203232%20Ins&amp;z=17&amp;hl=fr&amp;output=embed\" title=\"Physio Activa — Rämismatte 21, 3232 Ins\" loading=\"lazy\" allowfullscreen referrerpolicy=\"no-referrer-when-downgrade\"></iframe>\n</section>\n\n<a class=\"pa-wafab\" href=\"https://wa.me/41766273838?text=Bonjour%2C%20je%20souhaite%20prendre%20rendez-vous%20chez%20Physio%20Activa%20%28physio%20%C3%A0%20Estavayer%29.\" target=\"_blank\" rel=\"noopener\" aria-label=\"Contacter Physio Activa sur WhatsApp\"><i class=\"fa-brands fa-whatsapp\" aria-hidden=\"true\"></i></a>\n\n</div>\n\n<script>\n(function(){\n  function safe(fn,n){try{fn()}catch(e){console.warn(n,e)}}\n  function initReveal(){\n    var els=document.querySelectorAll('.pa-lp .reveal');\n    if(!('IntersectionObserver' in window)){els.forEach(function(e){e.classList.add('in')});return;}\n    var io=new IntersectionObserver(function(en){en.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target);}})},{threshold:0.05});\n    els.forEach(function(e){io.observe(e)});\n    setTimeout(function(){els.forEach(function(e){e.classList.add('in')})},6000);\n  }\n  function initFAQ(){\n    var l=document.getElementById('paFaq'); if(!l)return;\n    var items=l.querySelectorAll('.faq');\n    items.forEach(function(d){\n      var btn=d.querySelector('button'),ans=d.querySelector('.ans');\n      if(d.classList.contains('open'))ans.style.maxHeight=ans.scrollHeight+'px';\n      btn.addEventListener('click',function(){\n        var open=d.classList.contains('open');\n        items.forEach(function(x){x.classList.remove('open');x.querySelector('.ans').style.maxHeight=null;x.querySelector('button').setAttribute('aria-expanded','false');});\n        if(!open){d.classList.add('open');ans.style.maxHeight=ans.scrollHeight+'px';btn.setAttribute('aria-expanded','true');}\n      });\n    });\n  }\n  function boot(){var root=document.querySelector('.pa-lp'); if(root)root.classList.add('is-js');safe(initReveal,'reveal');safe(initFAQ,'faq');}\n  if(document.readyState!=='loading'){boot();}else{document.addEventListener('DOMContentLoaded',boot);}\n})();\n</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@graph\": [{\"@type\": \"Physiotherapy\", \"@id\": \"https://physioactiva.ch/#physiotherapy\", \"name\": \"Physio Activa\", \"url\": \"https://physioactiva.ch/\", \"logo\": \"https://physioactiva.ch/wp-content/uploads/2026/06/Physio-Activa-Logo00001.png\", \"image\": \"https://physioactiva.ch/wp-content/uploads/2025/04/Physio-Activa-00031.jpg\", \"telephone\": \"+41 76 627 38 38\", \"email\": \"physio@physioactiva.ch\", \"address\": {\"@type\": \"PostalAddress\", \"streetAddress\": \"Rämismatte 21\", \"postalCode\": \"3232\", \"addressLocality\": \"Ins\", \"addressRegion\": \"BE\", \"addressCountry\": \"CH\"}, \"geo\": {\"@type\": \"GeoCoordinates\", \"latitude\": 46.99819373769458, \"longitude\": 7.107723111532297}, \"openingHoursSpecification\": [{\"@type\": \"OpeningHoursSpecification\", \"dayOfWeek\": [\"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\"], \"opens\": \"08:30\", \"closes\": \"20:00\"}], \"areaServed\": [{\"@type\": \"City\", \"name\": \"Estavayer\", \"sameAs\": \"https://fr.wikipedia.org/wiki/Estavayer_(Fribourg)\"}, {\"@type\": \"Place\", \"name\": \"Font\"}, {\"@type\": \"Place\", \"name\": \"Cheyres-Châbles\"}, {\"@type\": \"Place\", \"name\": \"Sévaz\"}, {\"@type\": \"Place\", \"name\": \"Les Montets\"}, {\"@type\": \"Place\", \"name\": \"Ins\"}], \"availableLanguage\": [\"fr\", \"de\", \"en\", \"es\", \"pt\"], \"sameAs\": [\"https://www.instagram.com/physio_activa_/\", \"https://www.facebook.com/profile.php?id=100094154144954\", \"https://www.google.com/maps?cid=17004812906479027083\"]}, {\"@type\": \"WebPage\", \"@id\": \"https://physioactiva.ch/physio-a-estavayer/#webpage\", \"url\": \"https://physioactiva.ch/physio-a-estavayer/\", \"name\": \"Physio à Estavayer-le-Lac – cabinet d'Ins ou domicile\", \"description\": \"Physio à Estavayer-le-Lac : cabinet d'Ins à 26 km, reconnu par toutes les assurances, ouvert jusqu'à 20h, domicile selon l'adresse. Réservez en ligne.\", \"inLanguage\": \"fr-CH\", \"about\": {\"@id\": \"https://physioactiva.ch/physio-a-estavayer/#service\"}, \"primaryImageOfPage\": {\"@type\": \"ImageObject\", \"url\": \"https://physioactiva.ch/wp-content/uploads/2025/06/Centerbild_IMG_9184-scaled-1.jpg\"}}, {\"@type\": \"Service\", \"@id\": \"https://physioactiva.ch/physio-a-estavayer/#service\", \"name\": \"Physiothérapie à Estavayer\", \"serviceType\": \"Physiothérapie au cabinet et à domicile\", \"provider\": {\"@id\": \"https://physioactiva.ch/#physiotherapy\"}, \"areaServed\": {\"@type\": \"City\", \"name\": \"Estavayer\", \"containedInPlace\": {\"@type\": \"AdministrativeArea\", \"name\": \"Canton de Fribourg\"}}}, {\"@type\": \"FAQPage\", \"@id\": \"https://physioactiva.ch/physio-a-estavayer/#faq\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"Où trouver un physiothérapeute près d'Estavayer-le-Lac ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Notre cabinet est à Ins, Rämismatte 21, au 1er étage du bâtiment Lidl, avec parking, à environ 26,4 km en ligne droite d'Estavayer. Selon votre adresse, nous pouvons aussi venir à domicile : contactez-nous pour le vérifier.\"}}, {\"@type\": \"Question\", \"name\": \"Quand dois-je consulter un physiothérapeute pour une douleur ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Quand la douleur dure depuis plus d'une semaine, réduit votre mobilité ou trouble votre sommeil, ou quand un gonflement persiste après une opération. Plus on la traite tôt, plus c'est simple. Un mollet soudain chaud et enflé se montre d'abord au médecin.\"}}, {\"@type\": \"Question\", \"name\": \"Physio Activa travaille-t-il avec toutes les compagnies d'assurance ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Oui. Notre cabinet est reconnu par toutes les compagnies d'assurance maladie en Suisse. Nous disposons de toutes les autorisations sanitaires nécessaires et accueillons les patients quel que soit leur canton de résidence.\"}}, {\"@type\": \"Question\", \"name\": \"Combien de séances me faut-il ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"La durée du traitement varie selon votre situation, et le trajet depuis la Broye est pris en compte dans le rythme proposé. Lors de la première visite, nous établissons une estimation adaptée à votre cas.\"}}, {\"@type\": \"Question\", \"name\": \"Venez-vous à Font, à Sévaz ou à Cheyres-Châbles ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Ces villages, comme Les Montets, sont proches d'Estavayer. Selon votre adresse, nous pouvons aussi venir à domicile : contactez-nous pour le vérifier.\"}}, {\"@type\": \"Question\", \"name\": \"Comment choisir son physiothérapeute ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Que vous choisissiez un physiothérapeute à Estavayer ou à Ins, vérifiez qu'il est reconnu par les assurances, qu'il traite votre problème et que vous comprenez ses explications. La distance et les horaires comptent aussi.\"}}, {\"@type\": \"Question\", \"name\": \"Comment savoir si j'ai besoin d'un drainage lymphatique ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Un gonflement qui persiste après une opération, une jambe lourde qui garde la marque du doigt ou un lymphœdème diagnostiqué sont des signes à montrer au médecin, qui oriente vers le drainage si besoin.\"}}, {\"@type\": \"Question\", \"name\": \"Puis-je commencer après une hospitalisation à l'HIB ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Oui. Avec les consignes remises à la sortie, nous organisons la suite de votre rééducation, avec un rendez-vous dans la semaine dans la plupart des cas.\"}}, {\"@type\": \"Question\", \"name\": \"Dans quelles langues se passent les séances ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"En français, la langue d'Estavayer, mais aussi en allemand, en anglais, en espagnol ou en portugais si vous préférez.\"}}]}]}</script>\n"}, "elements": []}], "isInner": false}], "isInner": false}], "page_settings": {"hide_title": "yes"}, "version": "0.4", "title": "Physio à Estavayer-le-Lac : au cabinet d'Ins ou à domicile", "type": "page"}