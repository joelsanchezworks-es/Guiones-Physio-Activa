{"content": [{"id": "5e74ff5", "elType": "section", "settings": {"layout": "full_width", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "f09e9f5", "elType": "column", "settings": {"_column_size": 100, "_inline_size": 100}, "elements": [{"id": "fbe5945", "elType": "widget", "widgetType": "html", "settings": {"html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Inter:wght@400;500;600&display=swap');\n@import url('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css');\n/* === Header menu above hero (WordPress nav) === */\n.pa-nav{position:relative;z-index:1000}\n.pa-nav .pa-mega,.pa-nav .pa-dd{z-index:1001}\n.elementor-location-header,header:has(.pa-nav),section:has(.pa-nav),.e-con:has(.pa-nav){position:relative;z-index:1000}\n\n.pa-lp{--navy:#0E2C4F;--azure:#29A9E0;--azure-d:#1E8AC0;--tint:#EAF6FC;--soft:#F4F9FD;--ink:#12273F;--muted:#5C7186;--body:#41576c;--line:#E4EEF5;--wa:#25D366;--wa-d:#1FB457;\n  font-family:'Inter',system-ui,sans-serif !important;color:var(--ink);background:#fff;line-height:1.7;overflow-x:hidden}\n.pa-lp *,.pa-lp *::before,.pa-lp *::after{box-sizing:border-box}\n.pa-lp h1,.pa-lp h2,.pa-lp h3,.pa-lp p,.pa-lp ul,.pa-lp ol,.pa-lp figure,.pa-lp table{margin:0;padding:0}\n.pa-lp img{max-width:100%;height:auto;display:block}\n.pa-lp a{text-decoration:none !important}\n.pa-lp h1,.pa-lp h2,.pa-lp h3,.pa-lp .eyebrow,.pa-lp .btn{font-family:'Poppins',system-ui,sans-serif !important}\n.pa-lp .wrap{max-width:1180px;margin:0 auto;padding:0 24px}\n.pa-lp .sec{padding:72px 0}\n.pa-lp .sec.soft{background:var(--soft)}\n.pa-lp a:focus-visible,.pa-lp button:focus-visible{outline:3px solid var(--azure);outline-offset:3px}\n\n/* Eyebrow + section heads */\n.pa-lp .eyebrow{display:inline-flex;align-items:center;gap:10px;color:var(--azure);font-weight:600;font-size:13px;letter-spacing:.16em;text-transform:uppercase;margin-bottom:14px}\n.pa-lp .eyebrow::before{content:\"\";width:26px;height:2px;background:var(--azure);display:inline-block;pointer-events:none}\n.pa-lp .sec-head{max-width:760px;margin:0 auto 42px;text-align:center}\n.pa-lp .sec-head .eyebrow{justify-content:center}\n.pa-lp h2.title{font-size:36px !important;font-weight:700 !important;line-height:1.2 !important;color:var(--navy) !important;letter-spacing:-.5px;margin:0 0 12px !important}\n.pa-lp .sec-head p{color:var(--muted);font-size:17px}\n\n/* Buttons */\n.pa-lp .btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;background:var(--azure) !important;color:#fff !important;font-weight:600 !important;font-size:15px !important;line-height:1.2 !important;padding:15px 28px !important;border-radius:10px !important;border:none !important;cursor:pointer;transition:background .25s,transform .25s,box-shadow .25s}\n.pa-lp .btn:hover{background:var(--azure-d) !important;transform:translateY(-2px);box-shadow:0 12px 26px rgba(41,169,224,.32)}\n.pa-lp .btn i,.pa-lp .btn i::before{color:inherit !important}\n.pa-lp .btn.wa{background:var(--wa) !important}\n.pa-lp .btn.wa:hover{background:var(--wa-d) !important;box-shadow:0 12px 26px rgba(37,211,102,.34)}\n.pa-lp .btn.ghost{background:transparent !important;border:1.5px solid rgba(255,255,255,.4) !important}\n.pa-lp .btn.ghost:hover{background:rgba(255,255,255,.12) !important;box-shadow:none}\n.pa-lp .btn.outline{background:transparent !important;color:var(--azure-d) !important;border:1.5px solid var(--azure) !important;padding:12px 22px !important;font-size:14px !important}\n.pa-lp .btn.outline:hover{background:var(--azure) !important;color:#fff !important;box-shadow:none}\n\n/* Hero (image-forward, same as blog articles) */\n.pa-lp .art-hero-sec{position:relative;background-color:var(--navy);background-size:cover;background-position:center;padding:120px 24px;overflow:hidden}\n.pa-lp .art-hero-overlay{position:absolute;inset:0;background:rgba(0,0,0,.42);pointer-events:none}\n.pa-lp .art-hero{position:relative;text-align:center;max-width:880px;margin:0 auto;color:#fff}\n.pa-lp .art-hero .eyebrow{justify-content:center;color:#fff;letter-spacing:.18em;text-shadow:0 1px 12px rgba(0,0,0,.55)}\n.pa-lp .art-hero .eyebrow::before{width:30px}\n.pa-lp .art-hero h1{font-size:46px !important;font-weight:700 !important;line-height:1.12 !important;letter-spacing:-.6px;color:#fff !important;margin:10px 0 20px !important;text-shadow:0 2px 28px rgba(0,0,0,.6)}\n.pa-lp .hero-cta{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin:26px 0 0}\n.pa-lp .ameta{display:inline-flex;flex-wrap:wrap;justify-content:center;gap:8px 16px;color:#fff;font-size:14px;font-family:'Poppins',sans-serif;background:rgba(0,0,0,.32);border:1px solid rgba(255,255,255,.22);padding:10px 20px;border-radius:40px;-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}\n\n/* Breadcrumb */\n.pa-lp .crumbs{background:var(--soft);border-bottom:1px solid var(--line);font-size:13.5px}\n.pa-lp .crumbs ol{list-style:none !important;display:flex;flex-wrap:wrap;gap:6px;max-width:828px;margin:0 auto !important;padding:14px 24px !important}\n.pa-lp .crumbs li{color:var(--muted);margin:0 !important}\n.pa-lp .crumbs li+li::before{content:\"›\";margin-right:6px}\n.pa-lp .crumbs a{color:var(--azure-d) !important;font-weight:500}\n\n/* Article body */\n.pa-lp .article{max-width:780px;margin:0 auto}\n.pa-lp .article .lead-intro{font-size:18.5px;color:var(--ink);line-height:1.75;margin-bottom:28px}\n.pa-lp .article h2{font-size:28px !important;color:var(--navy) !important;font-weight:700 !important;line-height:1.25 !important;margin:52px 0 14px !important}\n.pa-lp .article p{color:var(--body);font-size:16.5px;line-height:1.8;margin-bottom:16px}\n.pa-lp .article a.inlink{color:var(--azure-d) !important;font-weight:600;border-bottom:1px solid rgba(41,169,224,.45)}\n.pa-lp .article a.inlink:hover{border-bottom-color:var(--azure-d)}\n.pa-lp .article figure{margin:28px 0 8px}\n.pa-lp .article figure img{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:16px}\n.pa-lp .article figcaption{font-size:13.5px;color:var(--muted);margin-top:10px}\n.pa-lp .inline-actions{display:flex;gap:12px;flex-wrap:wrap;margin:4px 0 6px}\n\n/* Quick facts table (extractable for Google & AI) */\n.pa-lp .fiche{border:1px solid var(--line);border-radius:16px;overflow:hidden;margin:4px 0 8px}\n.pa-lp .fiche table{width:100%;border-collapse:collapse !important;border:none !important;font-size:15.5px;margin:0 !important}\n.pa-lp .fiche caption{caption-side:top;text-align:left;background:var(--navy);color:#fff;font-family:'Poppins',sans-serif;font-weight:600;font-size:16px;padding:14px 20px}\n.pa-lp .fiche th,.pa-lp .fiche td{padding:13px 20px !important;border:none !important;border-top:1px solid var(--line) !important;text-align:left !important;vertical-align:top;line-height:1.6}\n.pa-lp .fiche th{width:32%;color:var(--navy) !important;font-family:'Poppins',sans-serif;font-weight:600 !important;font-size:14.5px;background:var(--soft) !important}\n.pa-lp .fiche td{color:var(--body) !important;background:#fff !important}\n\n/* Services link grid */\n.pa-lp .soins-list{list-style:none !important;display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:20px 0 8px !important;padding:0 !important}\n.pa-lp .soins-list li{margin:0 !important;list-style:none !important}\n.pa-lp .soins-list a{display:block;height:100%;background:#fff;border:1px solid var(--line);border-radius:12px;padding:14px 18px;transition:border-color .2s,background .2s}\n.pa-lp .soins-list a:hover{border-color:var(--azure);background:var(--tint)}\n.pa-lp .soins-list strong{display:block;font-family:'Poppins',sans-serif;font-weight:600;color:var(--navy);font-size:15.5px;line-height:1.35}\n.pa-lp .soins-list span{display:block;color:var(--muted);font-size:14px;line-height:1.5;margin-top:3px}\n\n/* Inline CTA */\n.pa-lp .cta-inline{background:var(--soft);border:1px solid var(--line);border-left:4px solid var(--azure);border-radius:12px;padding:22px 24px;margin:32px 0 8px}\n.pa-lp .cta-inline p{color:var(--ink);margin-bottom:14px}\n.pa-lp .cta-inline .btn{padding:12px 22px !important;font-size:14px !important}\n\n/* Why grid */\n.pa-lp .why-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px;max-width:980px;margin:0 auto}\n.pa-lp .wcard{background:#fff;border:1px solid var(--line);border-radius:18px;padding:30px 28px}\n.pa-lp .wcard .wic{width:52px;height:52px;border-radius:14px;background:var(--tint);color:var(--azure);display:flex;align-items:center;justify-content:center;font-size:21px;margin-bottom:16px}\n.pa-lp .wcard h3{font-size:20px !important;color:var(--navy) !important;font-weight:600 !important;line-height:1.3 !important;margin:0 0 8px !important}\n.pa-lp .wcard p{color:var(--muted);font-size:15px;line-height:1.7}\n\n/* FAQ */\n.pa-lp .faq-list{max-width:820px;margin:0 auto}\n.pa-lp .faq{border:1px solid var(--line);border-radius:14px;margin-bottom:14px;overflow:hidden;background:#fff;transition:border-color .25s,box-shadow .25s}\n.pa-lp .faq.open{border-color:var(--azure);box-shadow:0 14px 30px rgba(41,169,224,.10)}\n.pa-lp .faq h3{margin:0 !important;font-size:inherit !important;line-height:inherit !important}\n.pa-lp .faq button{width:100%;text-align:left;background:none !important;border:none !important;border-radius:0 !important;padding:20px 24px !important;font-family:'Poppins',sans-serif !important;font-weight:600 !important;font-size:17px !important;line-height:1.4 !important;color:var(--navy) !important;text-transform:none !important;letter-spacing:0 !important;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:16px}\n.pa-lp .faq .q-ic{width:30px;height:30px;border-radius:8px;background:var(--tint);color:var(--azure);display:flex;align-items:center;justify-content:center;flex:0 0 30px;transition:transform .3s,background .3s,color .3s}\n.pa-lp .faq.open .q-ic{background:var(--azure);color:#fff;transform:rotate(45deg)}\n.pa-lp.is-js .faq .ans{max-height:0;overflow:hidden;transition:max-height .35s ease}\n.pa-lp .faq .ans p{padding:0 24px 22px;color:var(--muted);font-size:15.5px;line-height:1.75}\n\n/* CTA band */\n.pa-lp .cta-band{background:var(--navy);color:#fff;text-align:center;position:relative;overflow:hidden;padding:88px 0}\n.pa-lp .cta-band::before{content:\"\";position:absolute;width:380px;height:380px;border-radius:50%;background:rgba(41,169,224,.14);top:-150px;right:-110px;pointer-events:none}\n.pa-lp .cta-band::after{content:\"\";position:absolute;width:240px;height:240px;border-radius:50%;border:2px dashed rgba(255,255,255,.08);bottom:-90px;left:-70px;pointer-events:none}\n.pa-lp .cta-band .wrap{position:relative}\n.pa-lp .cta-band h2{font-size:36px !important;font-weight:700 !important;line-height:1.2 !important;color:#fff !important;letter-spacing:-.5px;margin:0 0 14px !important}\n.pa-lp .cta-band .s1{font-size:18.5px;color:#DCE9F4;max-width:720px;margin:0 auto 30px}\n.pa-lp .cta-actions{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;align-items:center}\n\n/* Map */\n.pa-lp .map iframe{width:100%;height:480px;border:0;display:block}\n\n/* Reveal */\n.pa-lp .reveal{transition:opacity .7s ease,transform .7s ease}\n.pa-lp.is-js .reveal{opacity:0;transform:translateY(22px)}\n.pa-lp.is-js .reveal.in{opacity:1;transform:none}\n\n/* WhatsApp FAB (standard) */\n.pa-wafab{position:fixed;right:22px;bottom:104px;z-index:1200;width:58px;height:58px;border-radius:50%;background:#25D366;color:#fff !important;display:flex;align-items:center;justify-content:center;font-size:30px;text-decoration:none !important;animation:paWaPulse 2.2s infinite;transition:background .2s}\n.pa-wafab:hover{background:#1FB457}\n.pa-wafab i,.pa-wafab i::before{color:#fff !important}\n@keyframes paWaPulse{0%{box-shadow:0 0 0 0 rgba(37,211,102,.55)}70%{box-shadow:0 0 0 16px rgba(37,211,102,0)}100%{box-shadow:0 0 0 0 rgba(37,211,102,0)}}\n\n/* === Añadidos SEO (mismo estilo) === */\n.pa-lp .article h3{font-size:20px !important;color:var(--navy) !important;font-weight:600 !important;line-height:1.3 !important;margin:28px 0 8px !important}\n.pa-lp .article ul.plain{margin:0 0 16px 20px !important;color:var(--body);font-size:16.5px;line-height:1.8}\n.pa-lp .article ul.plain li{margin:4px 0}\n.pa-lp .article a.inlink,.pa-lp .faq .ans a,.pa-lp .wcard a{color:var(--azure-d) !important;font-weight:600}\n.pa-lp .photo-credit{position:absolute;right:12px;bottom:8px;font-size:11px;color:rgba(255,255,255,.75);font-family:'Inter',sans-serif}\n.pa-lp .photo-credit a{color:rgba(255,255,255,.85) !important;text-decoration:underline !important}\n\n@media(max-width:980px){\n  .pa-lp .art-hero h1{font-size:38px !important}\n  .pa-lp h2.title,.pa-lp .cta-band h2{font-size:30px !important}\n}\n@media(max-width:620px){\n  .pa-lp .sec{padding:54px 0}\n  .pa-lp .art-hero-sec{padding:84px 18px 76px}\n  .pa-lp .art-hero h1{font-size:30px !important}\n  .pa-lp .article h2{font-size:23px !important;margin-top:42px !important}\n  .pa-lp .why-grid,.pa-lp .soins-list{grid-template-columns:1fr}\n  .pa-lp .hero-cta .btn,.pa-lp .cta-actions .btn{width:100%}\n  .pa-lp .fiche th,.pa-lp .fiche td{display:block;width:100%}\n  .pa-lp .fiche th{padding-bottom:2px !important}\n  .pa-lp .fiche td{border-top:none !important;padding-top:2px !important;background:var(--soft) !important}\n  .pa-lp .map iframe{height:380px}\n  .pa-wafab{right:14px;bottom:92px;width:54px;height:54px;font-size:28px}\n}\n@media(prefers-reduced-motion:reduce){\n  .pa-wafab{animation:none}\n  .pa-lp .reveal,.pa-lp.is-js .reveal{transition:none;opacity:1;transform:none}\n}\n\n</style>\n\n<div class=\"pa-lp\">\n\n<!-- ===== HERO ===== -->\n<section class=\"art-hero-sec\" style=\"background-image:url('https://physioactiva.ch/wp-content/uploads/2025/06/Centerbild_IMG_9184-scaled-1.jpg')\">\n  <div class=\"art-hero-overlay\" aria-hidden=\"true\"></div>\n  <div class=\"art-hero\">\n    <span class=\"eyebrow\">Physiothérapie · Lausanne</span>\n    <h1>Physio à Lausanne : au cabinet d&#x27;Ins ou à domicile</h1>\n    <div class=\"ameta\">Par l'équipe Physio Activa · Physiothérapie à Lausanne</div>\n    <div class=\"hero-cta\"><a class=\"btn\" href=\"https://www.onedoc.ch/fr/cabinet-de-physiotherapie/anet/ebdut/physioactiva\" target=\"_blank\" rel=\"noopener\"><i class=\"fa-solid fa-calendar-check\" aria-hidden=\"true\"></i> <span>Rendez-vous online</span></a><a class=\"btn wa\" href=\"https://wa.me/41766273838?text=Bonjour%2C%20je%20souhaite%20prendre%20rendez-vous%20chez%20Physio%20Activa%20%28physio%20%C3%A0%20Lausanne%29.\" target=\"_blank\" rel=\"noopener\"><i class=\"fa-brands fa-whatsapp\" aria-hidden=\"true\"></i> <span>WhatsApp</span></a></div>\n  </div>\n  \n</section>\n\n<!-- ===== BREADCRUMB ===== -->\n<nav class=\"crumbs\" aria-label=\"Fil d'Ariane\">\n  <ol><li><a href=\"/\">Accueil</a></li><li aria-current=\"page\">Physiothérapie à Lausanne</li></ol>\n</nav>\n\n<!-- ===== ARTICLE ===== -->\n<section class=\"sec\">\n <div class=\"wrap\">\n  <article class=\"article\">\n   <p class=\"lead-intro\">Vous habitez Lausanne et cherchez un physio ? Physio Activa est installé à Ins, dans le Seeland bernois, à environ 65 km en ligne droite de la capitale vaudoise : nous n'avons ni centre ni cabinet de physiothérapie à Lausanne. Un suivi à domicile sur place est. Le cabinet est reconnu par toutes les assurances maladie en Suisse ; le plus simple est de nous téléphoner.</p>\n\n   <div class=\"fiche\">\n    <table>\n     <caption>Physio Activa pour les patients de Lausanne, en bref</caption>\n     <tbody>\n      <tr><th scope=\"row\">Cabinet</th><td>Rämismatte 21, 3232 Ins (1er étage du bâtiment Lidl, InsGym), parking à disposition</td></tr>\n      <tr><th scope=\"row\">Depuis Lausanne</th><td>Environ 65,0 km à vol d&#x27;oiseau jusqu&#x27;au cabinet d&#x27;Ins</td></tr>\n      <tr><th scope=\"row\">À domicile</th><td>Selon votre adresse (Pully, Prilly, Renens, Épalinges) : contactez-nous pour le vérifier</td></tr>\n      <tr><th scope=\"row\">Délai</th><td>Rendez-vous dans la semaine dans la plupart des cas</td></tr>\n      <tr><th scope=\"row\">Horaires</th><td>Du lundi au vendredi, jusqu&#x27;à 20h</td></tr>\n      <tr><th scope=\"row\">Langues</th><td>Français, allemand, anglais, espagnol et portugais</td></tr>\n      <tr><th scope=\"row\">Assurances</th><td>Cabinet reconnu par toutes les compagnies d&#x27;assurance maladie en Suisse</td></tr>\n      <tr><th scope=\"row\">Réservation</th><td>En ligne (OneDoc), par WhatsApp ou au 076 627 38 38</td></tr>\n     </tbody>\n    </table>\n   </div>\n\n      <h2>Quand consulter un physio, et quand voir d'abord un médecin ?</h2>\n   <p>Une sciatique qui descend dans la jambe, une nuque bloquée après des heures d'écran, une épaule douloureuse au sport ou une lombalgie qui revient : ce sont des motifs typiques.</p>\n   <p>Certaines situations relèvent d'abord du médecin : douleur après un traumatisme violent, engourdissement du bassin ou des organes génitaux, faiblesse qui s'aggrave, perte de poids inexpliquée, douleur constante même au repos. En cas d'urgence vitale, composez le 144.</p>\n   <div class=\"inline-actions\"><a class=\"btn outline\" href=\"https://www.google.com/maps/dir/?api=1&amp;origin=Lausanne%2C%20Suisse&amp;destination=Physio%20Activa%2C%20R%C3%A4mismatte%2021%2C%203232%20Ins\" target=\"_blank\" rel=\"noopener\"><i class=\"fa-solid fa-route\" aria-hidden=\"true\"></i> <span>Itinéraire depuis Lausanne</span></a></div>\n   <figure>\n    <img src=\"https://physioactiva.ch/wp-content/uploads/2025/04/Physio-Activa-00031.jpg\" alt=\"Physiothérapeute de Physio Activa en séance, physio pour les patients de Lausanne\" width=\"1200\" height=\"675\" loading=\"lazy\" decoding=\"async\">\n   </figure>\n   <h2>Quelle prise en charge selon votre situation ?</h2>\n   <h3>Si vous séjournez dans le Seeland</h3>\n   <p>Le cabinet d'Ins, dans l'InsGym, a du sens si vous travaillez, étudiez ou passez vos vacances dans la région des Trois-Lacs.</p>\n   <h3>À domicile et communes voisines</h3>\n   <p>Plusieurs séances par semaine depuis Ins jusqu'à Pully, Prilly, Renens ou Épalinges ne sont pas toujours réalistes, et nous préférons le dire. Jours de passage :. Voir <a class=\"inlink\" href=\"/physiotherapeute-a-domicile/\">physiothérapie à domicile</a>.</p>\n   <h3>Après une intervention au CHUV</h3>\n   <p>La rééducation peut se poursuivre chez nous si vous résidez temporairement dans le Seeland, sur la base de vos consignes de sortie.</p>\n   <h3>Dos, nuque, sciatique et épaule</h3>\n   <ul class=\"plain\"><li><a class=\"inlink\" href=\"/sciatique-hernie-discale/\">Sciatique et hernie discale</a> : soulager la jambe, puis reprendre l'effort pas à pas.</li><li><a class=\"inlink\" href=\"/douleur-cervicale-au-cou/\">Douleur cervicale</a> : tensions liées à l'écran ou au stress.</li><li><a class=\"inlink\" href=\"/lesions-de-lepaule/\">Épaule</a> : amplitude et force du bras.</li><li><a class=\"inlink\" href=\"/mal-de-dos-lombaire/\">Mal de dos et lombalgie</a> : un programme adapté à votre quotidien.</li></ul>\n   <p>Liste complète : <a class=\"inlink\" href=\"/pour-les-patients/\">toutes les pathologies</a>.</p>\n   <h3>Drainage lymphatique</h3>\n   <p>Indiqué pour un lymphœdème ou un gonflement persistant après une opération, il demande souvent des séances rapprochées, un rythme difficile à tenir depuis Lausanne. Présentation : <a class=\"inlink\" href=\"/drainage-lymphatique/\">drainage lymphatique chez Physio Activa</a>.</p>\n   <h3>Massage thérapeutique</h3>\n   <p>Il cible contractures et tensions de nuque ou de dos, au cabinet d'Ins. Détails : <a class=\"inlink\" href=\"/massage-therapeutique/\">massage thérapeutique</a>.</p>\n   <h3>Physio du sport</h3>\n   <p>Coureurs ou joueurs de club : après une déchirure ou une ligamentoplastie, la reprise se prépare par du renforcement progressif sur les machines d'InsGym. Voir <a class=\"inlink\" href=\"/physio-du-sport/\">physio du sport</a>.</p>\n   <h3>Dry needling</h3>\n   <p>La puncture sèche traite des points gâchettes avec une aiguille fine et stérile, sans injection, en complément d'une séance. En savoir plus : <a class=\"inlink\" href=\"/physioactiva-puncture-seche/\">puncture sèche (dry needling)</a>.</p>\n   <h2>Comment se déroule votre prise en charge ?</h2>\n   <h3>Prise de rendez-vous</h3>\n   <p>Appelez-nous ou écrivez sur WhatsApp avant de réserver : à 65 km, nous vérifions ensemble qu'un suivi à Ins est réaliste pour vous, puis vous choisissez un créneau en ligne.</p>\n   <h3>Bilan</h3>\n   <p>Nous questionnons votre quotidien et votre historique, puis nous observons comment vous bougez et ce qui déclenche la douleur.</p>\n   <h3>Séances au cabinet ou à domicile</h3>\n   <p>Thérapie manuelle et exercice se combinent au cabinet d'Ins ; à Lausanne même, le domicile reste.</p>\n   <h3>Autonomie et prévention</h3>\n   <p>Un programme personnel vous permet de continuer seul et de mieux gérer les rechutes, un vrai atout quand on vit à 65 km.</p>\n   <figure>\n    <img src=\"https://physioactiva.ch/wp-content/uploads/2025/04/Physio-Activa-00036.jpg\" alt=\"Salle de traitement du cabinet Physio Activa à Ins, proche de Lausanne\" width=\"1200\" height=\"675\" loading=\"lazy\" decoding=\"async\">\n   </figure>\n   <h2>Venir au cabinet d'Ins depuis Lausanne</h2>\n   <p>Le cabinet, dans le bâtiment de l'InsGym, est à environ 65 km en ligne droite de Lausanne, chef-lieu du district de Lausanne. Accès : <a class=\"inlink\" href=\"/nous-trouver/\">Nous trouver</a>. Bonne nouvelle pour les Lausannois, venus d'une ville francophone : malgré l'adresse bernoise, tout se fait en français, et l'espagnol est aussi possible.</p>\n   <h2>Assurances et horaires : physio à Lausanne</h2>\n   <p>Malgré l'adresse bernoise, rien ne change pour un patient vaudois : notre cabinet est reconnu par toutes les compagnies d'assurance maladie en Suisse et accueille les patients quel que soit leur canton de résidence. Nous recevons du lundi au vendredi, jusqu'à 20h, ce qui peut faciliter une venue en fin de journée. Prenez contact au 076 627 38 38 ou sur WhatsApp, ou réservez en ligne.</p>\n  </article>\n </div>\n</section>\n\n<!-- ===== POURQUOI ===== -->\n<section class=\"sec soft\">\n <div class=\"wrap\">\n  <div class=\"sec-head reveal\">\n   <span class=\"eyebrow\">Pourquoi Physio Activa</span>\n   <h2 class=\"title\">Pourquoi les patients de Lausanne choisissent Physio Activa</h2>\n   <p>Un cabinet de physiothérapie à Ins, des soins à domicile dans la région et une équipe qui vous reçoit en cinq langues.</p>\n  </div>\n  <div class=\"why-grid reveal\"><div class=\"wcard\"><div class=\"wic\" aria-hidden=\"true\"><i class=\"fa-solid fa-shield-heart\"></i></div><h3>Reconnu par toutes les assurances</h3><p>Notre cabinet est reconnu par toutes les assurances maladie en Suisse et accueille les patients de tous les cantons, Vaud compris.</p></div><div class=\"wcard\"><div class=\"wic\" aria-hidden=\"true\"><i class=\"fa-solid fa-house-medical\"></i></div><h3>Au cabinet d'Ins ou à domicile</h3><p>Nous recevons à Ins. Pour l'agglomération lausannoise, la visite à domicile dépend de.</p></div><div class=\"wcard\"><div class=\"wic\" aria-hidden=\"true\"><i class=\"fa-solid fa-clipboard-list\"></i></div><h3>Bilan et plan de traitement</h3><p>Avant toute technique, un examen de votre problème ; ensuite, un plan écrit avec vous, revu au fil des séances.</p></div><div class=\"wcard\"><div class=\"wic\" aria-hidden=\"true\"><i class=\"fa-solid fa-calendar-check\"></i></div><h3>Rendez-vous en ligne, par téléphone ou WhatsApp</h3><p>Agenda en ligne, téléphone au 076 627 38 38 ou WhatsApp. À 65 km, un premier échange évite un déplacement inutile.</p></div></div>\n </div>\n</section>\n\n<!-- ===== FAQ ===== -->\n<section class=\"sec\">\n <div class=\"wrap\">\n  <div class=\"sec-head\">\n   <span class=\"eyebrow\">Questions fréquentes</span>\n   <h2 class=\"title\">Questions fréquentes sur la physio à Lausanne</h2>\n  </div>\n  <div class=\"faq-list\" id=\"paFaq\"><div class=\"faq open\"><h3><button type=\"button\" aria-expanded=\"true\" aria-controls=\"faq-a1\"><span class=\"faq-q\">Quand dois-je consulter un physiothérapeute pour une douleur ?</span><span class=\"q-ic\" aria-hidden=\"true\"><i class=\"fa-solid fa-plus\"></i></span></button></h3><div class=\"ans\" id=\"faq-a1\"><p>Lorsqu'une douleur dure plus d'une semaine, limite vos gestes ou vous empêche de dormir, ou pour préparer une reprise sportive. Traitée tôt, elle se règle en général plus simplement. Une douleur constante au repos ou une faiblesse qui s'aggrave relèvent d'abord du médecin.</p></div></div><div class=\"faq\"><h3><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-a2\"><span class=\"faq-q\">Physio Activa travaille-t-il avec toutes les compagnies d&#x27;assurance ?</span><span class=\"q-ic\" aria-hidden=\"true\"><i class=\"fa-solid fa-plus\"></i></span></button></h3><div class=\"ans\" id=\"faq-a2\"><p>Oui. Notre cabinet est reconnu par toutes les compagnies d'assurance maladie en Suisse. Nous disposons de toutes les autorisations sanitaires nécessaires et accueillons les patients quel que soit leur canton de résidence.</p></div></div><div class=\"faq\"><h3><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-a3\"><span class=\"faq-q\">Combien de séances me faut-il ?</span><span class=\"q-ic\" aria-hidden=\"true\"><i class=\"fa-solid fa-plus\"></i></span></button></h3><div class=\"ans\" id=\"faq-a3\"><p>La durée du traitement varie selon votre situation. Lors de la première visite, nous établissons une estimation adaptée à votre cas ; à 65 km, nous privilégions un programme qui vous rend vite autonome.</p></div></div><div class=\"faq\"><h3><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-a4\"><span class=\"faq-q\">À quelle distance se trouve le cabinet ?</span><span class=\"q-ic\" aria-hidden=\"true\"><i class=\"fa-solid fa-plus\"></i></span></button></h3><div class=\"ans\" id=\"faq-a4\"><p>Environ 65 km en ligne droite séparent Lausanne d'Ins.</p></div></div><div class=\"faq\"><h3><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-a5\"><span class=\"faq-q\">Comment choisir son physiothérapeute ?</span><span class=\"q-ic\" aria-hidden=\"true\"><i class=\"fa-solid fa-plus\"></i></span></button></h3><div class=\"ans\" id=\"faq-a5\"><p>Vérifiez qu'il peut vous suivre au rythme nécessaire : sur plusieurs semaines, la proximité compte autant que la spécialité, une question honnête à se poser depuis Lausanne.</p></div></div><div class=\"faq\"><h3><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-a6\"><span class=\"faq-q\">Comment appelle-t-on un kinésithérapeute en Suisse ?</span><span class=\"q-ic\" aria-hidden=\"true\"><i class=\"fa-solid fa-plus\"></i></span></button></h3><div class=\"ans\" id=\"faq-a6\"><p>Physiothérapeute. « Kiné » est le mot employé en France pour le même métier.</p></div></div><div class=\"faq\"><h3><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-a7\"><span class=\"faq-q\">À quoi sert le drainage lymphatique ?</span><span class=\"q-ic\" aria-hidden=\"true\"><i class=\"fa-solid fa-plus\"></i></span></button></h3><div class=\"ans\" id=\"faq-a7\"><p>À faciliter l'écoulement de la lymphe quand un membre reste gonflé, après une opération, un traitement oncologique ou en cas de lymphœdème. Comme il demande souvent des séances rapprochées, parlons ensemble du rythme possible depuis Lausanne.</p></div></div><div class=\"faq\"><h3><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-a8\"><span class=\"faq-q\">Pourquoi faire du dry needling ?</span><span class=\"q-ic\" aria-hidden=\"true\"><i class=\"fa-solid fa-plus\"></i></span></button></h3><div class=\"ans\" id=\"faq-a8\"><p>Pour relâcher un point gâchette qui entretient une douleur musculaire, à l'épaule, à la nuque ou au mollet, en complément des exercices.</p></div></div><div class=\"faq\"><h3><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-a9\"><span class=\"faq-q\">Pouvez-vous venir à Pully, Prilly ou Renens ?</span><span class=\"q-ic\" aria-hidden=\"true\"><i class=\"fa-solid fa-plus\"></i></span></button></h3><div class=\"ans\" id=\"faq-a9\"><p>Ces communes sont loin de notre zone habituelle (Seeland et Trois-Lacs) :.</p></div></div></div>\n </div>\n</section>\n\n<!-- ===== CTA BAND ===== -->\n<section class=\"cta-band\">\n <div class=\"wrap reveal\">\n  <h2>Besoin d&#x27;un physio à Lausanne ou dans les environs ?</h2>\n  <p class=\"s1\">Expliquez-nous vos besoins : nous répondons sans détour, même si la distance complique un suivi. Réservation en ligne , téléphone 076 627 38 38, WhatsApp +41 76 627 38 38.</p>\n  <div class=\"cta-actions\"><a class=\"btn\" href=\"https://www.onedoc.ch/fr/cabinet-de-physiotherapie/anet/ebdut/physioactiva\" target=\"_blank\" rel=\"noopener\"><i class=\"fa-solid fa-calendar-check\" aria-hidden=\"true\"></i> <span>Rendez-vous online</span></a><a class=\"btn wa\" href=\"https://wa.me/41766273838?text=Bonjour%2C%20je%20souhaite%20prendre%20rendez-vous%20chez%20Physio%20Activa%20%28physio%20%C3%A0%20Lausanne%29.\" target=\"_blank\" rel=\"noopener\"><i class=\"fa-brands fa-whatsapp\" aria-hidden=\"true\"></i> <span>WhatsApp</span></a><a class=\"btn ghost\" href=\"tel:+41766273838\"><i class=\"fa-solid fa-phone\" aria-hidden=\"true\"></i> <span>Appelez-nous · 076 627 38 38</span></a></div>\n </div>\n</section>\n\n<!-- ===== MAP ===== -->\n<section class=\"map\">\n <iframe src=\"https://maps.google.com/maps?q=Physio%20Activa%2C%20R%C3%A4mismatte%2021%2C%203232%20Ins&amp;z=17&amp;hl=fr&amp;output=embed\" title=\"Physio Activa — Rämismatte 21, 3232 Ins\" loading=\"lazy\" allowfullscreen referrerpolicy=\"no-referrer-when-downgrade\"></iframe>\n</section>\n\n<a class=\"pa-wafab\" href=\"https://wa.me/41766273838?text=Bonjour%2C%20je%20souhaite%20prendre%20rendez-vous%20chez%20Physio%20Activa%20%28physio%20%C3%A0%20Lausanne%29.\" target=\"_blank\" rel=\"noopener\" aria-label=\"Contacter Physio Activa sur WhatsApp\"><i class=\"fa-brands fa-whatsapp\" aria-hidden=\"true\"></i></a>\n\n</div>\n\n<script>\n(function(){\n  function safe(fn,n){try{fn()}catch(e){console.warn(n,e)}}\n  function initReveal(){\n    var els=document.querySelectorAll('.pa-lp .reveal');\n    if(!('IntersectionObserver' in window)){els.forEach(function(e){e.classList.add('in')});return;}\n    var io=new IntersectionObserver(function(en){en.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target);}})},{threshold:0.05});\n    els.forEach(function(e){io.observe(e)});\n    setTimeout(function(){els.forEach(function(e){e.classList.add('in')})},6000);\n  }\n  function initFAQ(){\n    var l=document.getElementById('paFaq'); if(!l)return;\n    var items=l.querySelectorAll('.faq');\n    items.forEach(function(d){\n      var btn=d.querySelector('button'),ans=d.querySelector('.ans');\n      if(d.classList.contains('open'))ans.style.maxHeight=ans.scrollHeight+'px';\n      btn.addEventListener('click',function(){\n        var open=d.classList.contains('open');\n        items.forEach(function(x){x.classList.remove('open');x.querySelector('.ans').style.maxHeight=null;x.querySelector('button').setAttribute('aria-expanded','false');});\n        if(!open){d.classList.add('open');ans.style.maxHeight=ans.scrollHeight+'px';btn.setAttribute('aria-expanded','true');}\n      });\n    });\n  }\n  function boot(){var root=document.querySelector('.pa-lp'); if(root)root.classList.add('is-js');safe(initReveal,'reveal');safe(initFAQ,'faq');}\n  if(document.readyState!=='loading'){boot();}else{document.addEventListener('DOMContentLoaded',boot);}\n})();\n</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@graph\": [{\"@type\": \"Physiotherapy\", \"@id\": \"https://physioactiva.ch/#phy