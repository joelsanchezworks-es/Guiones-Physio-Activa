nction(e){e.classList.add('in')});return;}\n    var io=new IntersectionObserver(function(en){en.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target);}})},{threshold:0.05});\n    els.forEach(function(e){io.observe(e)});\n    setTimeout(function(){els.forEach(function(e){e.classList.add('in')})},6000);\n  }\n  function initFAQ(){\n    var list=document.querySelectorAll('.pa-home .faq');\n    list.forEach(function(d){\n      var ans=d.querySelector('.ans'),btn=d.querySelector('button');\n      if(d.classList.contains('open')&&ans)ans.style.maxHeight=ans.scrollHeight+'px';\n      btn.addEventListener('click',function(){\n        var open=d.classList.contains('open');\n        list.forEach(function(x){x.classList.remove('open');var a=x.querySelector('.ans');if(a)a.style.maxHeight=null;});\n        if(!open){d.classList.add('open');if(ans)ans.style.maxHeight=ans.scrollHeight+'px';}\n      });\n    });\n  }\n  function boot(){var r=document.querySelector('.pa-home');if(r)r.classList.add('is-js');safe(initReveal,'reveal');safe(initFAQ,'faq');}\n  if(document.readyState!=='loading'){boot();}else{document.addEventListener('DOMContentLoaded',boot);}\n})();\n</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@graph\": [{\"@type\": \"Physiotherapy\", \"@id\": \"https://physioactiva.ch/#physiotherapy\", \"name\": \"Physio Activa\", \"url\": \"https://physioactiva.ch/\", \"telephone\": \"+41766273838\", \"address\": {\"@type\": \"PostalAddress\", \"streetAddress\": \"Rämismatte 21\", \"postalCode\": \"3232\", \"addressLocality\": \"Ins\", \"addressRegion\": \"BE\", \"addressCountry\": \"CH\"}, \"geo\": {\"@type\": \"GeoCoordinates\", \"latitude\": 46.99819373769458, \"longitude\": 7.107723111532297}, \"openingHoursSpecification\": [{\"@type\": \"OpeningHoursSpecification\", \"dayOfWeek\": [\"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\"], \"opens\": \"08:30\", \"closes\": \"19:30\"}], \"areaServed\": [{\"@type\": \"City\", \"name\": \"Ins\"}, {\"@type\": \"City\", \"name\": \"Anet\"}, {\"@type\": \"City\", \"name\": \"Mont-Vully\"}, {\"@type\": \"City\", \"name\": \"Neuchâtel\"}, {\"@type\": \"City\", \"name\": \"La Neuveville\"}, {\"@type\": \"City\", \"name\": \"Avenches\"}, {\"@type\": \"City\", \"name\": \"Lyss\"}, {\"@type\": \"City\", \"name\": \"Biel/Bienne\"}, {\"@type\": \"City\", \"name\": \"Fribourg\"}, {\"@type\": \"City\", \"name\": \"Payerne\"}], \"availableLanguage\": [\"fr\", \"es\"], \"sameAs\": [\"https://www.google.com/maps?cid=17004812906479027083\"]}, {\"@type\": \"WebPage\", \"@id\": \"https://physioactiva.ch/physio-a-lyss/#webpage\", \"url\": \"https://physioactiva.ch/physio-a-lyss/\", \"name\": \"Physio à Lyss – à domicile ou à Ins | Physio Activa\", \"description\": \"Physio à Lyss : séances en français au cabinet d'Ins ou à domicile, remboursées sur prescription (LAMal, LAA, AI, AM). Réservez en ligne.\", \"inLanguage\": \"fr-CH\", \"about\": {\"@id\": \"https://physioactiva.ch/physio-a-lyss/#service\"}, \"breadcrumb\": {\"@id\": \"https://physioactiva.ch/physio-a-lyss/#breadcrumb\"}}, {\"@type\": \"BreadcrumbList\", \"@id\": \"https://physioactiva.ch/physio-a-lyss/#breadcrumb\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Accueil\", \"item\": \"https://physioactiva.ch/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Physio à Lyss\", \"item\": \"https://physioactiva.ch/physio-a-lyss/\"}]}, {\"@type\": \"Service\", \"@id\": \"https://physioactiva.ch/physio-a-lyss/#service\", \"name\": \"Physiothérapie pour les patients de Lyss\", \"serviceType\": \"Physiothérapie au cabinet et à domicile\", \"provider\": {\"@id\": \"https://physioactiva.ch/#physiotherapy\"}, \"areaServed\": {\"@type\": \"City\", \"name\": \"Lyss\", \"sameAs\": \"https://fr.wikipedia.org/wiki/Lyss\", \"containedInPlace\": {\"@type\": \"AdministrativeArea\", \"name\": \"Canton de Berne\"}}}, {\"@type\": \"FAQPage\", \"@id\": \"https://physioactiva.ch/physio-a-lyss/#faq\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"Ma commune est germanophone : les séances se font-elles en français ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Oui. À Ins comme lors d'une visite à domicile, tout se passe en français, ou en espagnol si vous préférez. Vos documents médicaux en allemand ne posent aucun problème.\"}}, {\"@type\": \"Question\", \"name\": \"Comment appelle-t-on un kinésithérapeute en Suisse ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"En Suisse, on parle de physiothérapeute, ou simplement de physio. À Lyss et dans le reste du Seeland germanophone, vous lirez « Physiotherapeut » : c'est le même métier.\"}}, {\"@type\": \"Question\", \"name\": \"Quand faire de la physiothérapie ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Dès qu'une douleur ou une raideur limite vos gestes du quotidien plus de quelques jours, après une entorse, une fracture ou une opération, ou quand votre médecin vous la recommande.\"}}, {\"@type\": \"Question\", \"name\": \"Quel est le rôle d'un physiothérapeute ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Il évalue votre mouvement, traite la douleur par des techniques manuelles et vous guide avec des exercices pour retrouver force, mobilité et confiance.\"}}, {\"@type\": \"Question\", \"name\": \"À quelle distance se trouve le cabinet ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Lyss est à environ 17 km en ligne droite d'Ins. Les deux communes appartiennent à l'arrondissement administratif du Seeland, dans le canton de Berne.\"}}, {\"@type\": \"Question\", \"name\": \"Venez-vous aussi à Aarberg ou à Busswil ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Ces localités voisines de Lyss font partie des zones que nous pouvons étudier pour des séances à domicile [À CONFIRMER : localités desservies]. Indiquez votre adresse lors de la réservation.\"}}, {\"@type\": \"Question\", \"name\": \"J'ai été opéré au Spital Aarberg : puis-je poursuivre chez vous ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Oui, avec l'ordonnance de physiothérapie remise à la sortie. Nous reprenons le programme selon les indications de votre chirurgien [À CONFIRMER : délai du premier rendez-vous].\"}}, {\"@type\": \"Question\", \"name\": \"Est-ce normal d'avoir plus mal après une séance ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Une légère sensibilité pendant un jour ou deux est fréquente, surtout après un travail sur des tissus tendus ou de nouveaux exercices. Si la douleur augmente nettement ou dure, parlez-en lors de la séance suivante pour ajuster le traitement.\"}}, {\"@type\": \"Question\", \"name\": \"Quel est le prix d'une séance de physiothérapie ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Le prix suit la structure tarifaire fixée au niveau national entre physiothérapeutes et assureurs [À CONFIRMER : tarif appliqué]. Avec une ordonnance, votre assurance paie la séance ; seules la franchise et la quote-part LAMal restent à votre charge.\"}}]}]}</script>\n"}, "elements": []}], "isInner": false}], "isInner": false}], "page_settings": {"hide_title": "yes"}, "version": "0.4", "title": "Physio à Lyss : au cabinet d'Ins ou à domicile", "type": "page"}