rySelector('button');\n      if(d.classList.contains('open')&&ans)ans.style.maxHeight=ans.scrollHeight+'px';\n      btn.addEventListener('click',function(){\n        var open=d.classList.contains('open');\n        list.forEach(function(x){x.classList.remove('open');var a=x.querySelector('.ans');if(a)a.style.maxHeight=null;});\n        if(!open){d.classList.add('open');if(ans)ans.style.maxHeight=ans.scrollHeight+'px';}\n      });\n    });\n  }\n  function boot(){var r=document.querySelector('.pa-home');if(r)r.classList.add('is-js');safe(initReveal,'reveal');safe(initFAQ,'faq');}\n  if(document.readyState!=='loading'){boot();}else{document.addEventListener('DOMContentLoaded',boot);}\n})();\n</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@graph\": [{\"@type\": \"Physiotherapy\", \"@id\": \"https://physioactiva.ch/#physiotherapy\", \"name\": \"Physio Activa\", \"url\": \"https://physioactiva.ch/\", \"telephone\": \"+41766273838\", \"address\": {\"@type\": \"PostalAddress\", \"streetAddress\": \"Rämismatte 21\", \"postalCode\": \"3232\", \"addressLocality\": \"Ins\", \"addressRegion\": \"BE\", \"addressCountry\": \"CH\"}, \"geo\": {\"@type\": \"GeoCoordinates\", \"latitude\": 46.99819373769458, \"longitude\": 7.107723111532297}, \"openingHoursSpecification\": [{\"@type\": \"OpeningHoursSpecification\", \"dayOfWeek\": [\"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\"], \"opens\": \"08:30\", \"closes\": \"20:00\"}], \"areaServed\": [{\"@type\": \"City\", \"name\": \"Ins\"}, {\"@type\": \"City\", \"name\": \"Anet\"}, {\"@type\": \"City\", \"name\": \"Mont-Vully\"}, {\"@type\": \"City\", \"name\": \"Neuchâtel\"}, {\"@type\": \"City\", \"name\": \"La Neuveville\"}, {\"@type\": \"City\", \"name\": \"Avenches\"}, {\"@type\": \"City\", \"name\": \"Lyss\"}, {\"@type\": \"City\", \"name\": \"Biel/Bienne\"}, {\"@type\": \"City\", \"name\": \"Fribourg\"}, {\"@type\": \"City\", \"name\": \"Payerne\"}], \"availableLanguage\": [\"fr\", \"es\"], \"sameAs\": [\"https://www.google.com/maps?cid=17004812906479027083\"]}, {\"@type\": \"WebPage\", \"@id\": \"https://physioactiva.ch/physio-a-sugiez/#webpage\", \"url\": \"https://physioactiva.ch/physio-a-sugiez/\", \"name\": \"Physio à Sugiez et Vully – domicile ou Ins | Physio Activa\", \"description\": \"Physio dans le Vully, à Sugiez et alentour : au cabinet d'Ins ou à domicile, reconnu par toutes les assurances. Réservez en ligne ou par WhatsApp.\", \"inLanguage\": \"fr-CH\", \"about\": {\"@id\": \"https://physioactiva.ch/physio-a-sugiez/#service\"}, \"breadcrumb\": {\"@id\": \"https://physioactiva.ch/physio-a-sugiez/#breadcrumb\"}}, {\"@type\": \"BreadcrumbList\", \"@id\": \"https://physioactiva.ch/physio-a-sugiez/#breadcrumb\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Accueil\", \"item\": \"https://physioactiva.ch/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Physio à Sugiez et dans le Vully\", \"item\": \"https://physioactiva.ch/physio-a-sugiez/\"}]}, {\"@type\": \"Service\", \"@id\": \"https://physioactiva.ch/physio-a-sugiez/#service\", \"name\": \"Physiothérapie pour les patients de Sugiez (Mont-Vully)\", \"serviceType\": \"Physiothérapie au cabinet et à domicile\", \"provider\": {\"@id\": \"https://physioactiva.ch/#physiotherapy\"}, \"areaServed\": {\"@type\": \"City\", \"name\": \"Mont-Vully\", \"sameAs\": \"https://fr.wikipedia.org/wiki/Mont-Vully\", \"containedInPlace\": {\"@type\": \"AdministrativeArea\", \"name\": \"Canton de Fribourg\"}}}, {\"@type\": \"FAQPage\", \"@id\": \"https://physioactiva.ch/physio-a-sugiez/#faq\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"Quand dois-je consulter un physiothérapeute pour une douleur ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Si la douleur dure plus d'une semaine, limite vos mouvements, perturbe votre sommeil ou revient après chaque journée à la vigne ou au jardin. Plus on la traite tôt, plus c'est simple.\"}}, {\"@type\": \"Question\", \"name\": \"Physio Activa travaille-t-il avec toutes les compagnies d'assurance ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Oui. Notre cabinet est reconnu par toutes les compagnies d'assurance maladie en Suisse. Nous disposons de toutes les autorisations sanitaires nécessaires et accueillons les patients quel que soit leur canton de résidence.\"}}, {\"@type\": \"Question\", \"name\": \"Combien de séances me faut-il ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"La durée du traitement varie selon votre situation : un lumbago récent ne se traite pas comme la rééducation d'une prothèse. Lors de la première visite, nous établissons une estimation adaptée à votre cas.\"}}, {\"@type\": \"Question\", \"name\": \"À combien de kilomètres se trouve le cabinet ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Depuis Sugiez, comptez environ 4,9 km en ligne droite jusqu'à l'InsGym, Rämismatte 21, à Ins : l'une des zones les plus proches de notre cabinet.\"}}, {\"@type\": \"Question\", \"name\": \"Vous déplacez-vous aussi à Praz, Môtier ou Lugnorre ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Ces villages figurent déjà parmi les localités citées pour les visites à domicile sur notre site, tout comme Guévaux. Les jours de passage restent à convenir avec vous [À CONFIRMER : jours de passage dans le Mont-Vully].\"}}, {\"@type\": \"Question\", \"name\": \"Qu'est-ce que ça veut dire, la rééducation ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"C'est le travail progressif pour retrouver une fonction diminuée : marcher sans boiter, lever le bras, porter une caisse de raisin. Elle combine traitement manuel et exercices.\"}}, {\"@type\": \"Question\", \"name\": \"J'ai été opéré à l'HFR Meyriez-Murten : comment poursuivre ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Apportez les consignes de l'hôpital et réservez dès votre retour. Nous reprenons la rééducation au cabinet ou chez vous si vous ne pouvez pas encore conduire [À CONFIRMER : domicile après une opération].\"}}, {\"@type\": \"Question\", \"name\": \"Comment choisir son physiothérapeute ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Regardez la proximité, la possibilité d'un suivi à domicile et la clarté du plan de traitement. Depuis le Vully, un cabinet à quelques kilomètres limite la fatigue des trajets.\"}}]}]}</script>\n"}, "elements": []}], "isInner": false}], "isInner": false}], "page_settings": {"hide_title": "yes"}, "version": "0.4", "title": "Physio à Sugiez et dans le Vully : au cabinet d'Ins ou à domicile", "type": "page"}